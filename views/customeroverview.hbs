<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Analytics | {{businessName}}</title>
    <link rel="stylesheet" href="/customeroverview.css">
    <script src="/js/customerview.js" defer></script>
</head>
<body>

<main class="customer-dashboard">

    <header class="customer-header">

        <div class="customer-header-brand">
            <div class="customer-header-eyebrow">
                MARKETFLOW / CUSTOMER ANALYTICS
            </div>

            <h1>Customer Overview</h1>

            <p>
                Understand customer growth, value, retention and profitability.
            </p>
        </div>

        <div class="customer-header-business">
            <span class="customer-header-business-label">
                BUSINESS
            </span>
            <strong>{{businessName}}</strong>

        </div>
        <a href="/productpages/products" class="customer-analytics-nav-link is-active-n"> Dashboard </a>

    </header>

    <nav class="customer-analytics-nav" aria-label="Customer analytics navigation">

    <div class="customer-analytics-nav-inner">

        <a
            href="#customer-overview"
            class="customer-analytics-nav-link is-active"
        >
            Overview
        </a>

        <a
            href="#customer-acquisition"
            class="customer-analytics-nav-link"
        >
            Acquisition
        </a>

        <a
            href="#customer-retention"
            class="customer-analytics-nav-link"
        >
            Retention
        </a>

        <a
            href="#customer-segmentation"
            class="customer-analytics-nav-link"
        >
            Segmentation
        </a>

        <a
            href="#customer-rfm"
            class="customer-analytics-nav-link"
        >
            RFM
        </a>

        <a
            href="#customer-clv"
            class="customer-analytics-nav-link"
        >
            CLV
        </a>

        <a href="#customer-profitability" class="customer-analytics-nav-link" >
            Profitability
        </a>

        <a href="#customer-purchasing-behavior" class="customer-analytics-nav-link">
                Purchasing Behavior
            </a>

        <a
            href="#customer-concentration"
            class="customer-analytics-nav-link"
        >
            Concentration
        </a>

        <a
            href="#customer-geographic-analysis"
            class="customer-analytics-nav-link"
        >
            Geography
        </a>

        <a  href="#customer-branch-analysis"
            class="customer-analytics-nav-link"
        >
            Branch Analysis
        </a>

        <a
            href="#customer-360"
            class="customer-analytics-nav-link"
        >
            Customer 360
        </a>

        <a href="#customer-decision-intelligence" class="customer-analytics-nav-link" >
            Decision Intelligence
        </a>

    </div>

</nav>

    <section class="customer-toolbar">

        <div class="customer-scope-summary">

            <span class="customer-scope-indicator"></span>

            <div>
                <span class="customer-scope-label">CURRENT VIEW</span>

                <strong>
                    {{#if isBranchScope}}
                        {{branchName}}
                    {{else}}
                        All Branches
                    {{/if}}
                </strong>
            </div>

        </div>

        <form
            method="GET"
            action="/customer-overview"
            class="customer-filters"
            autocomplete="off"
        >

            <div class="customer-filter">

                <label for="customerScope">
                    Scope
                </label>

                <select
                    name="scope"
                    id="customerScope"
                >
                    <option
                        value="business"
                        {{#if isBusinessScope}}selected{{/if}}
                    >
                        All Branches
                    </option>

                    <option
                        value="branch"
                        {{#if isBranchScope}}selected{{/if}}
                    >
                        Branch
                    </option>
                </select>

            </div>

            <div class="customer-filter">

                <label for="customerBranch">
                    Branch
                </label>

                <select
                    name="branch_id"
                    id="customerBranch"
                    {{#unless isBranchScope}}disabled{{/unless}}
                >

                    {{#each branches}}

                        <option
                            value="{{branch_id}}"
                            {{#if selected}}selected{{/if}}
                        >
                            {{branch_name}}
                        </option>

                    {{/each}}

                </select>

            </div>

            <div class="customer-filter">

                <label for="customerPeriod">
                    Period
                </label>

                <select
                    name="period"
                    id="customerPeriod"
                >

                    <option
                        value="today"
                        {{#ifEquals period "today"}}selected{{/ifEquals}}
                    >
                        Today
                    </option>

                    <option
                        value="week"
                        {{#ifEquals period "week"}}selected{{/ifEquals}}
                    >
                        This Week
                    </option>

                    <option
                        value="month"
                        {{#ifEquals period "month"}}selected{{/ifEquals}}
                    >
                        This Month
                    </option>

                    <option
                        value="quarter"
                        {{#ifEquals period "quarter"}}selected{{/ifEquals}}
                    >
                        This Quarter
                    </option>

                    <option
                        value="year"
                        {{#ifEquals period "year"}}selected{{/ifEquals}}
                    >
                        This Year
                    </option>

                    <option
                        value="all"
                        {{#ifEquals period "all"}}selected{{/ifEquals}}
                    >
                        All Time
                    </option>

                </select>

            </div>

            <button
                type="button"
                class="customer-refresh-button"
                id="customerRefresh"
                title="Refresh dashboard"
            >
                <span class="customer-refresh-icon">↻</span>
                <span>Refresh</span>
            </button>

        </form>

    </section>

    <section id="customer-overview" class="customer-dashboard-section">

        <div class="customer-section-heading">

            <div>
                <span class="customer-section-eyebrow">
                    PERFORMANCE SNAPSHOT
                </span>

                <h2>Customer Overview</h2>
            </div>

            <div class="customer-period-badge">
                {{period}}
            </div>

        </div>

        <div class="customer-kpi-grid">

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Total Customers
                    </span>

                    <span class="customer-kpi-icon">
                        ◉
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    {{overview.totalCustomers}}
                </strong>

                <span class="customer-kpi-description">
                    Customers registered
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Active Customers
                    </span>

                    <span class="customer-kpi-icon">
                        ●
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    {{overview.activeCustomers}}
                </strong>

                <span class="customer-kpi-description">
                    Currently active customers
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        New Customers
                    </span>

                    <span class="customer-kpi-icon">
                        +
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    {{overview.newCustomers}}
                </strong>

                <span class="customer-kpi-description">
                    Newly acquired customers
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Returning Customers
                    </span>

                    <span class="customer-kpi-icon">
                        ↻
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    {{overview.returningCustomers}}
                </strong>

                <span class="customer-kpi-description">
                    Customers who purchased more than once
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Customers With Purchases
                    </span>

                    <span class="customer-kpi-icon">
                        ✓
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    {{overview.customersWithPurchases}}
                </strong>

                <span class="customer-kpi-description">
                    Customers who completed purchases
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Customer Revenue
                    </span>

                    <span class="customer-kpi-icon">
                        ₵
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    ₵{{overview.customerRevenue}}
                </strong>

                <span class="customer-kpi-description">
                    Revenue generated by customers
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Average Customer Value
                    </span>

                    <span class="customer-kpi-icon">
                        ◈
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    ₵{{overview.averageCustomerValue}}
                </strong>

                <span class="customer-kpi-description">
                    Average revenue per purchasing customer
                </span>

            </article>

            <article class="customer-kpi-card">

                <div class="customer-kpi-top">
                    <span class="customer-kpi-label">
                        Average Order Value
                    </span>

                    <span class="customer-kpi-icon">
                        #
                    </span>
                </div>

                <strong class="customer-kpi-value">
                    ₵{{overview.averageOrderValue}}
                </strong>

                <span class="customer-kpi-description">
                    Average customer transaction value
                </span>

            </article>

        </div>

    </section>

    <!-- ================================================================
     CUSTOMER ACQUISITION
     ================================================================ -->

<section id="customer-acquisition" class="customer-dashboard-section customer-acquisition-section">

    <div class="customer-section-heading">

        <div>
            <span class="customer-section-eyebrow">
                CUSTOMER ACQUISITION
            </span>

            <h2>Acquisition Performance</h2>

            <p class="customer-section-description">
                Track new customer growth, first purchases and return behaviour.
            </p>
        </div>

        <div class="customer-acquisition-status">
            <span class="customer-acquisition-status-dot"></span>
            <span>
                {{#if isBranchScope}}
                    {{branchName}}
                {{else}}
                    All Branches
                {{/if}}
            </span>
        </div>

    </div>

    <div class="customer-acquisition-kpi-grid">

        <article class="customer-acquisition-card acquisition-new">

            <div class="customer-acquisition-card-top">

                <div>
                    <span class="customer-acquisition-card-label">
                        New Customers
                    </span>

                    <span class="customer-acquisition-card-caption">
                        First-time purchasers
                    </span>
                </div>

                <span class="customer-acquisition-icon">
                    +
                </span>

            </div>

            <strong class="customer-acquisition-value">
                {{acquisition.newCustomers}}
            </strong>

        </article>

        <article class="customer-acquisition-card acquisition-returned">

            <div class="customer-acquisition-card-top">

                <div>
                    <span class="customer-acquisition-card-label">
                        Returned Customers
                    </span>

                    <span class="customer-acquisition-card-caption">
                        Acquired customers who returned
                    </span>
                </div>

                <span class="customer-acquisition-icon">
                    ↻
                </span>

            </div>

            <strong class="customer-acquisition-value">
                {{acquisition.returnedCustomers}}
            </strong>

        </article>

        <article class="customer-acquisition-card acquisition-never-returned">

            <div class="customer-acquisition-card-top">

                <div>
                    <span class="customer-acquisition-card-label">
                        Never Returned
                    </span>

                    <span class="customer-acquisition-card-caption">
                        Acquired but did not return
                    </span>
                </div>

                <span class="customer-acquisition-icon">
                    !
                </span>

            </div>

            <strong class="customer-acquisition-value">
                {{acquisition.neverReturnedCustomers}}
            </strong>

        </article>

        <article class="customer-acquisition-card acquisition-rate">

            <div class="customer-acquisition-card-top">

                <div>
                    <span class="customer-acquisition-card-label">
                        Return Rate
                    </span>

                    <span class="customer-acquisition-card-caption">
                        Acquired customers who returned
                    </span>
                </div>

                <span class="customer-acquisition-icon">
                    %
                </span>

            </div>

            <strong class="customer-acquisition-value">
                {{acquisition.returnRate}}%
            </strong>

        </article>

    </div>

    <div class="customer-acquisition-grid">

        <article class="customer-acquisition-panel customer-acquisition-trend-panel">

            <div class="customer-panel-header">

                <div>
                    <span class="customer-panel-eyebrow">
                        GROWTH TREND
                    </span>

                    <h3>New Customer Acquisition</h3>

                    <p>
                        Customers making their first completed purchase.
                    </p>
                </div>

                <span class="customer-panel-badge">
                    {{period}}
                </span>

            </div>

            <div class="customer-acquisition-chart-wrapper">
                <canvas id="customerAcquisitionTrendChart"></canvas>

                <div
                    id="customerAcquisitionTrendEmpty"
                    class="customer-chart-empty"
                    hidden
                >
                    <span>—</span>
                    <strong>No acquisition data</strong>
                    <small>
                        No new customers were acquired during this period.
                    </small>
                </div>
            </div>

            <div
                id="customerAcquisitionTrendSource"
                class="customer-data-source"
                aria-hidden="true"
            >
                {{#each acquisition.trend}}
                    <span
                        data-period="{{period}}"
                        data-new-customers="{{newCustomers}}"
                    ></span>
                {{/each}}
            </div>

        </article>

        <article class="customer-acquisition-panel customer-acquisition-branch-panel">

            <div class="customer-panel-header">

                <div>
                    <span class="customer-panel-eyebrow">
                        BRANCH PERFORMANCE
                    </span>

                    <h3>Acquisition by Branch</h3>

                    <p>
                        New customers attributed to their first purchase branch.
                    </p>
                </div>

            </div>

            <div class="customer-branch-acquisition-list">

                {{#if acquisition.byBranch.length}}

                    {{#each acquisition.byBranch}}

                        <div
                            class="customer-branch-acquisition-row"
                            data-branch-name="{{branchName}}"
                            data-new-customers="{{newCustomers}}"
                        >

                            <div class="customer-branch-acquisition-info">

                                <span class="customer-branch-acquisition-name">
                                    {{branchName}}
                                </span>

                                <span class="customer-branch-acquisition-count">
                                    {{newCustomers}} new customers
                                </span>

                            </div>

                            <div class="customer-branch-acquisition-bar">

                                <span
                                    class="customer-branch-acquisition-fill"
                                    style="width: 0%"
                                ></span>

                            </div>

                            <strong class="customer-branch-acquisition-value">
                                {{newCustomers}}
                            </strong>

                        </div>

                    {{/each}}

                {{else}}

                    <div class="customer-acquisition-empty">
                        <span>—</span>
                        <strong>No branch acquisition data</strong>
                        <small>
                            There are no new customers for this period.
                        </small>
                    </div>

                {{/if}}

            </div>

        </article>

    </div>

</section>

<!-- ================================================================
     CUSTOMER RETENTION — STEP 3
     ================================================================ -->

<section
    id="customer-retention"
    class="customer-dashboard-section customer-retention-section"
>

    <div class="customer-section-heading">

        <div>
            <span class="customer-section-eyebrow">
                CUSTOMER RETENTION
            </span>

            <h2>Retention &amp; Repeat Purchase Performance</h2>

            <p class="customer-section-description">
                Understand how effectively acquired customers return and continue purchasing.
            </p>
        </div>

        <div
            class="customer-retention-direction"
            id="customerRetentionDirection"
        >
            <span class="customer-retention-direction-icon">
                {{retention.direction}}
            </span>

            <div>
                <span class="customer-retention-direction-label">
                    RETENTION TREND
                </span>

                <strong>
                    {{retention.direction}}
                </strong>
            </div>
        </div>

    </div>

    <!-- ============================================================
         RETENTION KPIs
         ============================================================ -->

    <div class="customer-retention-kpi-grid">

        <article class="customer-retention-card retention-returning">

            <div class="customer-retention-card-top">

                <div>
                    <span class="customer-retention-card-label">
                        Returning Customers
                    </span>

                    <span class="customer-retention-card-caption">
                        Customers who purchased more than once
                    </span>
                </div>

                <span class="customer-retention-icon">
                    ↻
                </span>

            </div>

            <strong class="customer-retention-value">
                {{retention.returningCustomers}}
            </strong>

        </article>

        <article class="customer-retention-card retention-one-time">

            <div class="customer-retention-card-top">

                <div>
                    <span class="customer-retention-card-label">
                        One-Time Customers
                    </span>

                    <span class="customer-retention-card-caption">
                        Customers who purchased only once
                    </span>
                </div>

                <span class="customer-retention-icon">
                    1
                </span>

            </div>

            <strong class="customer-retention-value">
                {{retention.oneTimeCustomers}}
            </strong>

        </article>

        <article class="customer-retention-card retention-rate">

            <div class="customer-retention-card-top">

                <div>
                    <span class="customer-retention-card-label">
                        Repeat Purchase Rate
                    </span>

                    <span class="customer-retention-card-caption">
                        Share of purchasing customers who returned
                    </span>
                </div>

                <span class="customer-retention-icon">
                    %
                </span>

            </div>

            <strong class="customer-retention-value">
                {{retention.repeatPurchaseRate}}%
            </strong>

        </article>

        <article class="customer-retention-card retention-direction-card">

            <div class="customer-retention-card-top">

                <div>
                    <span class="customer-retention-card-label">
                        Retention Direction
                    </span>

                    <span class="customer-retention-card-caption">
                        Current retention movement
                    </span>
                </div>

                <span class="customer-retention-icon">
                    ↗
                </span>

            </div>

            <strong
                class="customer-retention-value"
                id="customerRetentionDirectionValue"
            >
                {{retention.direction}}
            </strong>

        </article>

    </div>

    <!-- ============================================================
         RETENTION ANALYSIS
         ============================================================ -->

    <div class="customer-retention-grid">

        <article class="customer-retention-panel">

            <div class="customer-panel-header">

                <div>
                    <span class="customer-panel-eyebrow">
                        RETENTION TREND
                    </span>

                    <h3>Repeat Purchase Rate</h3>

                    <p>
                        Movement in the share of customers who return to purchase.
                    </p>
                </div>

                <span class="customer-panel-badge">
                    {{period}}
                </span>

            </div>

            <div class="customer-retention-chart-wrapper">

                <canvas
                    id="customerRetentionTrendChart"
                ></canvas>

                <div
                    id="customerRetentionTrendEmpty"
                    class="customer-chart-empty"
                    hidden
                >
                    <span>—</span>

                    <strong>
                        No retention trend available
                    </strong>

                    <small>
                        There is not enough customer purchase history for this period.
                    </small>
                </div>

            </div>

            <div
                id="customerRetentionTrendSource"
                class="customer-data-source"
                aria-hidden="true"
            >

                {{#each retention.trend}}

                    <span
                        data-period="{{period}}"
                        data-returning="{{returningCustomers}}"
                        data-one-time="{{oneTimeCustomers}}"
                        data-rate="{{repeatPurchaseRate}}"
                    ></span>

                {{/each}}

            </div>

        </article>

        <article class="customer-retention-panel">

            <div class="customer-panel-header">

                <div>
                    <span class="customer-panel-eyebrow">
                        CUSTOMER MIX
                    </span>

                    <h3>Returning vs One-Time</h3>

                    <p>
                        Current customer purchasing composition.
                    </p>
                </div>

            </div>

            <div class="customer-retention-mix">

                <div class="customer-retention-mix-item">

                    <div class="customer-retention-mix-heading">

                        <span class="customer-retention-mix-dot returning"></span>

                        <span>
                            Returning Customers
                        </span>

                        <strong>
                            {{retention.returningCustomers}}
                        </strong>

                    </div>

                    <div class="customer-retention-mix-bar">

                        <span
                            class="customer-retention-mix-fill returning"
                            id="customerReturningMixFill"
                        ></span>

                    </div>

                </div>

                <div class="customer-retention-mix-item">

                    <div class="customer-retention-mix-heading">

                        <span class="customer-retention-mix-dot one-time"></span>

                        <span>
                            One-Time Customers
                        </span>

                        <strong>
                            {{retention.oneTimeCustomers}}
                        </strong>

                    </div>

                    <div class="customer-retention-mix-bar">

                        <span
                            class="customer-retention-mix-fill one-time"
                            id="customerOneTimeMixFill"
                        ></span>

                    </div>

                </div>

            </div>

            <div class="customer-retention-summary">

                <div class="customer-retention-summary-item">

                    <span>Returning share</span>

                    <strong id="customerReturningShare">
                        —
                    </strong>

                </div>

                <div class="customer-retention-summary-item">

                    <span>One-time share</span>

                    <strong id="customerOneTimeShare">
                        —
                    </strong>

                </div>

                <div class="customer-retention-summary-item">

                    <span>Repeat purchase rate</span>

                    <strong>
                        {{retention.repeatPurchaseRate}}%
                    </strong>

                </div>

            </div>

        </article>

    </div>

    <div
    id="customerRetentionSummarySource"
    class="customer-data-source"
    data-returning="{{retention.returningCustomers}}"
    data-one-time="{{retention.oneTimeCustomers}}"
    aria-hidden="true"
></div>

</section>

<!-- ================================================================
     CUSTOMER SEGMENTATION — STEP 4
     ================================================================ -->

<section
    id="customer-segmentation"
    class="customer-dashboard-section customer-segmentation-section"
>

    <div class="customer-section-heading">

        <div>
            <span class="customer-section-eyebrow">
                CUSTOMER SEGMENTATION
            </span>

            <h2>Customer Portfolio</h2>

            <p class="customer-section-description">
                Understand the size and composition of each customer segment.
            </p>
        </div>

        <div class="customer-segmentation-total">

            <span>
                PURCHASING CUSTOMERS
            </span>

            <strong>
                {{customerSegmentation.totalCustomers}}
            </strong>

        </div>

    </div>

    <!-- ============================================================
         SEGMENT CARDS
         ============================================================ -->

    <div class="customer-segment-grid">

        <article class="customer-segment-card segment-vip">

            <div class="customer-segment-card-top">

                <div>
                    <span class="customer-segment-label">
                        VIP / HIGH VALUE
                    </span>

                    <span class="customer-segment-description">
                        Highest-value customers
                    </span>
                </div>

                <span class="customer-segment-icon">
                    ◆
                </span>

            </div>

            <strong class="customer-segment-value">
                {{customerSegmentation.segments.vip.count}}
            </strong>

            <span class="customer-segment-share">
                {{customerSegmentation.segments.vip.percentage}}% of customers
            </span>

        </article>

        <article class="customer-segment-card segment-loyal">

            <div class="customer-segment-card-top">

                <div>
                    <span class="customer-segment-label">
                        LOYAL
                    </span>

                    <span class="customer-segment-description">
                        Repeat active customers
                    </span>
                </div>

                <span class="customer-segment-icon">
                    ★
                </span>

            </div>

            <strong class="customer-segment-value">
                {{customerSegmentation.segments.loyal.count}}
            </strong>

            <span class="customer-segment-share">
                {{customerSegmentation.segments.loyal.percentage}}% of customers
            </span>

        </article>

        <article class="customer-segment-card segment-regular">

            <div class="customer-segment-card-top">

                <div>
                    <span class="customer-segment-label">
                        REGULAR
                    </span>

                    <span class="customer-segment-description">
                        Active repeat customers
                    </span>
                </div>

                <span class="customer-segment-icon">
                    ●
                </span>

            </div>

            <strong class="customer-segment-value">
                {{customerSegmentation.segments.regular.count}}
            </strong>

            <span class="customer-segment-share">
                {{customerSegmentation.segments.regular.percentage}}% of customers
