        class="customer-data-source"
        aria-hidden="true"
        data-total-cities="{{customerGeographicAnalysis.totalCities}}"
        data-top-revenue-city="{{customerGeographicAnalysis.topRevenueCity}}"
        data-top-customer-city="{{customerGeographicAnalysis.topCustomerCity}}"
        data-total-revenue="{{customerGeographicAnalysis.totalRevenue}}"
        data-total-customers="{{customerGeographicAnalysis.totalCustomers}}"
    ></div>

    <div class="customer-kpi-grid customer-geographic-kpi-grid">

        <article class="customer-kpi-card customer-geographic-cities">
            <div class="customer-kpi-top">
                <span class="customer-kpi-label">Customer Locations</span>
                <span class="customer-kpi-icon">⌖</span>
            </div>
            <strong
                class="customer-kpi-value"
                id="customerGeographicTotalCities"
            >0</strong>
            <span class="customer-kpi-footnote">
                Distinct cities represented by customers
            </span>
        </article>

        <article class="customer-kpi-card">
            <div class="customer-kpi-top">
                <span class="customer-kpi-label">Registered Customers</span>
                <span class="customer-kpi-icon">◎</span>
            </div>
            <strong
                class="customer-kpi-value"
                id="customerGeographicTotalCustomers"
            >0</strong>
            <span class="customer-kpi-footnote">
                Customers within the selected scope
            </span>
        </article>

        <article class="customer-kpi-card customer-geographic-revenue">
            <div class="customer-kpi-top">
                <span class="customer-kpi-label">Customer Revenue</span>
                <span class="customer-kpi-icon">↗</span>
            </div>
            <strong
                class="customer-kpi-value"
                id="customerGeographicTotalRevenue"
            >0.00</strong>
            <span class="customer-kpi-footnote">
                Revenue from completed customer purchases
            </span>
        </article>

        <article class="customer-kpi-card">
            <div class="customer-kpi-top">
                <span class="customer-kpi-label">Top Revenue City</span>
                <span class="customer-kpi-icon">★</span>
            </div>
            <strong
                class="customer-kpi-value customer-geographic-city-value"
                id="customerGeographicTopRevenueCity"
            >—</strong>
            <span class="customer-kpi-footnote">
                Highest customer revenue
            </span>
        </article>

        <article class="customer-kpi-card">
            <div class="customer-kpi-top">
                <span class="customer-kpi-label">Largest Customer Base</span>
                <span class="customer-kpi-icon">♙</span>
            </div>
            <strong
                class="customer-kpi-value customer-geographic-city-value"
                id="customerGeographicTopCustomerCity"
            >—</strong>
            <span class="customer-kpi-footnote">
                Most registered customers
            </span>
        </article>

    </div>

    <div class="customer-analysis-grid customer-geographic-analysis-grid">

        <article class="customer-panel">
            <div class="customer-panel-heading">
                <div>
                    <h3>Customer Distribution by City</h3>
                    <p>
                        Compare the number of registered customers in each location.
                    </p>
                </div>
            </div>

            <div class="customer-chart-container customer-geographic-chart">
                <canvas
                    id="customerGeographicCustomersChart"
                    aria-label="Registered customers by city"
                    role="img"
                ></canvas>
            </div>
        </article>

        <article class="customer-panel">
            <div class="customer-panel-heading">
                <div>
                    <h3>Revenue by City</h3>
                    <p>
                        Identify the locations contributing the most customer revenue.
                    </p>
                </div>
            </div>

            <div class="customer-chart-container customer-geographic-chart">
                <canvas
                    id="customerGeographicRevenueChart"
                    aria-label="Customer revenue by city"
                    role="img"
                ></canvas>
            </div>
        </article>

    </div>

    <article class="customer-panel customer-geographic-ranking-panel">
        <div class="customer-panel-heading">
            <div>
                <span class="customer-section-eyebrow">
                    LOCATION PERFORMANCE
                </span>
                <h3>Geographic Performance Breakdown</h3>
                <p>
                    Compare customer counts, purchasing activity, revenue
                    and profitability across locations.
                </p>
            </div>
        </div>

        <div class="customer-table-wrapper">
            <table class="customer-data-table">
                <thead>
                    <tr>
                        <th>City</th>
                        <th>Registered Customers</th>
                        <th>Purchasing Customers</th>
                        <th>Transactions</th>
                        <th>Revenue</th>
                        <th>Average Spend</th>
                        <th>Revenue Share</th>
                    </tr>
                </thead>

                <tbody id="customerGeographicRankingBody">
                    {{#each customerGeographicAnalysis.cities}}
                        <tr
                            data-city="{{city}}"
                            data-customers="{{customers}}"
                            data-purchasing-customers="{{purchasingCustomers}}"
                            data-transactions="{{transactions}}"
                            data-revenue="{{revenue}}"
                            data-average-spend="{{averageSpend}}"
                            data-revenue-share="{{revenueShare}}"
                        >
                            <td>
                                <div class="customer-table-primary">
                                    {{city}}
                                </div>
                            </td>
                            <td>{{customers}}</td>
                            <td>{{purchasingCustomers}}</td>
                            <td>{{transactions}}</td>
                            <td data-money="{{revenue}}">{{revenue}}</td>
                            <td data-money="{{averageSpend}}">{{averageSpend}}</td>
                            <td data-share="{{revenueShare}}">
                                {{revenueShare}}%
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" class="customer-empty-state">
                                No geographic customer data is available
                                for this reporting scope.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </article>

    <article class="customer-panel customer-geographic-high-value-panel">
        <div class="customer-panel-heading">
            <div>
                <span class="customer-section-eyebrow">
                    MARKET OPPORTUNITIES
                </span>
                <h3>High-Value Locations</h3>
                <p>
                    Prioritize locations based on customer spending
                    and revenue contribution.
                </p>
            </div>
        </div>

        <div class="customer-table-wrapper">
            <table class="customer-data-table">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>City</th>
                        <th>Customers</th>
                        <th>Purchasing Customers</th>
                        <th>Revenue</th>
                        <th>Average Spend</th>
                        <th>Gross Profit</th>
                    </tr>
                </thead>

                <tbody id="customerGeographicHighValueBody">
                    {{#each customerGeographicAnalysis.highValueLocations}}
                        <tr>
                            <td>
                                <span class="customer-rank-badge">
                                    {{@index}}
                                </span>
                            </td>
                            <td>
                                <div class="customer-table-primary">
                                    {{city}}
                                </div>
                            </td>
                            <td>{{customers}}</td>
                            <td>{{purchasingCustomers}}</td>
                            <td data-money="{{revenue}}">{{revenue}}</td>
                            <td data-money="{{averageSpend}}">{{averageSpend}}</td>
                            <td data-money="{{grossProfit}}">{{grossProfit}}</td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" class="customer-empty-state">
                                No high-value location data is available.
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </article>

</section>

<!-- STEP 11: BRANCH ANALYSIS -->
<section id="customer-branch-analysis" class="customer-section">
    <div class="customer-section-header">
        <div>
            <span class="customer-section-eyebrow">CUSTOMER PERFORMANCE</span>
            <h2>Branch Analysis</h2>
            <p>Compare customer acquisition, purchasing activity, revenue, and profitability across branches.</p>
        </div>
        <div class="customer-section-badge">
            <span class="customer-status-dot"></span>
            Branch Performance
        </div>
    </div>

    {{#if customerBranchAnalysis}}
    <div class="customer-branch-kpi-grid">
        <article class="customer-branch-kpi-card">
            <div class="customer-branch-kpi-label">Total Customers</div>
            <div class="customer-branch-kpi-value">
                {{customerBranchAnalysis.totalCustomers}}
            </div>
            <div class="customer-branch-kpi-note">Registered customers in scope</div>
        </article>

        <article class="customer-branch-kpi-card">
            <div class="customer-branch-kpi-label">Purchasing Customers</div>
            <div class="customer-branch-kpi-value">
                {{customerBranchAnalysis.purchasingCustomers}}
            </div>
            <div class="customer-branch-kpi-note">Customers with completed purchases</div>
        </article>

        <article class="customer-branch-kpi-card">
            <div class="customer-branch-kpi-label">Customer Revenue</div>
            <div class="customer-branch-kpi-value">
                {{customerBranchAnalysis.formattedTotalRevenue}}
            </div>
            <div class="customer-branch-kpi-note">Revenue attributed to customers</div>
        </article>

        <article class="customer-branch-kpi-card">
            <div class="customer-branch-kpi-label">Gross Profit</div>
            <div class="customer-branch-kpi-value">
                {{customerBranchAnalysis.formattedTotalGrossProfit}}
            </div>
            <div class="customer-branch-kpi-note">Revenue less historical cost of goods</div>
        </article>

        <article class="customer-branch-kpi-card">
            <div class="customer-branch-kpi-label">Transactions</div>
            <div class="customer-branch-kpi-value">
                {{customerBranchAnalysis.totalTransactions}}
            </div>
            <div class="customer-branch-kpi-note">Completed customer transactions</div>
        </article>

        <article class="customer-branch-kpi-card">
            <div class="customer-branch-kpi-label">Repeat Purchase Rate</div>
            <div class="customer-branch-kpi-value">
                {{customerBranchAnalysis.formattedRepeatPurchaseRate}}%
            </div>
            <div class="customer-branch-kpi-note">Customers who purchased repeatedly</div>
        </article>
    </div>

    <div class="customer-branch-leaders">
        <article class="customer-branch-leader-card">
            <div class="customer-branch-leader-icon">↗</div>
            <div class="customer-branch-leader-content">
                <span>Revenue Leader</span>
                <h3>{{customerBranchAnalysis.topBranchByRevenue.branchName}}</h3>
                <p>{{customerBranchAnalysis.topBranchByRevenue.formattedRevenue}}</p>
            </div>
        </article>

        <article class="customer-branch-leader-card">
            <div class="customer-branch-leader-icon">◎</div>
            <div class="customer-branch-leader-content">
                <span>Customer Leader</span>
                <h3>{{customerBranchAnalysis.topBranchByCustomers.branchName}}</h3>
                <p>{{customerBranchAnalysis.topBranchByCustomers.totalCustomers}} customers</p>
            </div>
        </article>

        <article class="customer-branch-leader-card">
            <div class="customer-branch-leader-icon">◆</div>
            <div class="customer-branch-leader-content">
                <span>Profit Leader</span>
                <h3>{{customerBranchAnalysis.topBranchByProfit.branchName}}</h3>
                <p>{{customerBranchAnalysis.topBranchByProfit.formattedGrossProfit}}</p>
            </div>
        </article>
    </div>

    <div class="customer-branch-chart-grid">
        <article class="customer-panel customer-branch-chart-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Revenue by Branch</h3>
                    <p>Compare customer-generated revenue across branches.</p>
                </div>
            </div>
            <div class="customer-branch-chart-container">
                <canvas id="customerBranchRevenueChart"></canvas>
            </div>
        </article>

        <article class="customer-panel customer-branch-chart-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Customer Distribution</h3>
                    <p>Registered customer distribution across branches.</p>
                </div>
            </div>
            <div class="customer-branch-chart-container">
                <canvas id="customerBranchCustomerChart"></canvas>
            </div>
        </article>

        <article class="customer-panel customer-branch-chart-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Branch Profitability</h3>
                    <p>Compare revenue, cost of goods, and gross profit.</p>
                </div>
            </div>
            <div class="customer-branch-chart-container">
                <canvas id="customerBranchProfitChart"></canvas>
            </div>
        </article>

        <article class="customer-panel customer-branch-chart-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Customer Retention by Branch</h3>
                    <p>Compare repeat purchase rates across branches.</p>
                </div>
            </div>
            <div class="customer-branch-chart-container">
                <canvas id="customerBranchRetentionChart"></canvas>
            </div>
        </article>
    </div>

    <article class="customer-panel customer-branch-table-panel">
        <div class="customer-panel-header">
            <div>
                <h3>Branch Performance Comparison</h3>
                <p>Review acquisition, retention, customer value, and financial performance.</p>
            </div>
            <span class="customer-branch-table-count">
                {{customerBranchAnalysis.branches.length}} branches
            </span>
        </div>

        <div class="customer-table-wrapper">
            <table class="customer-data-table customer-branch-table" id="customerBranchPerformanceTable">
                <thead>
                    <tr>
                        <th>Branch</th>
                        <th>Customers</th>
                        <th>Purchasing</th>
                        <th>New</th>
                        <th>Returning</th>
                        <th>One-Time</th>
                        <th>Transactions</th>
                        <th>Revenue</th>
                        <th>Gross Profit</th>
                        <th>Avg. Customer Value</th>
                        <th>Avg. Order Value</th>
                        <th>Repeat Rate</th>
                        <th>Revenue Share</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each customerBranchAnalysis.branches}}
                    <tr>
                        <td>
                            <div class="customer-branch-name">{{branchName}}</div>
                            {{#if location}}
                            <div class="customer-branch-location">{{location}}</div>
                            {{/if}}
                        </td>
                        <td>{{totalCustomers}}</td>
                        <td>{{purchasingCustomers}}</td>
                        <td>{{newCustomers}}</td>
                        <td>{{returningCustomers}}</td>
                        <td>{{oneTimeCustomers}}</td>
                        <td>{{totalTransactions}}</td>
                        <td>{{formattedRevenue}}</td>
                        <td>{{formattedGrossProfit}}</td>
                        <td>{{formattedAverageCustomerValue}}</td>
                        <td>{{formattedAverageOrderValue}}</td>
                        <td>{{formattedRepeatPurchaseRate}}%</td>
                        <td>
                            <div class="customer-branch-share">
                                <span>{{formattedRevenueShare}}%</span>
                                <div class="customer-branch-share-track">
                                    <span style="width: {{revenueShare}}%;"></span>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="13" class="customer-table-empty">
                            No branch performance data is available for the selected scope.
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </article>

    {{else}}
    <div class="customer-empty-state">
        <h3>Branch analysis unavailable</h3>
        <p>Branch performance data could not be loaded for the current selection.</p>
    </div>
    {{/if}}
</section>

<!-- STEP 12: CUSTOMER 360 -->
<section id="customer-360" class="customer-section">
    <div class="customer-section-header">
        <div>
            <span class="customer-section-eyebrow">CUSTOMER INTELLIGENCE</span>
            <h2>Customer 360</h2>
            <p>Explore an individual customer's value, purchase history, behavior, and relationship with your business.</p>
        </div>
        <div class="customer-section-badge">
            <span class="customer-status-dot"></span>
            Customer Profile
        </div>
    </div>

    {{#if customer360}}
        {{#if customer360.customer}}
        <div class="customer-360-profile">
            <div class="customer-360-identity">
                <div class="customer-360-avatar">
                    {{customer360.customer.initials}}
                </div>
                <div class="customer-360-identity-details">
                    <div class="customer-360-name-row">
                        <h3>{{customer360.customer.customerName}}</h3>
                        <span class="customer-360-status customer-360-status-{{customer360.customer.statusClass}}">
                            {{customer360.customer.status}}
                        </span>
                    </div>
                    <p class="customer-360-code">
                        Customer Code: {{customer360.customer.customerCode}}
                    </p>
                    <div class="customer-360-contact">
                        {{#if customer360.customer.phone}}
                        <span>{{customer360.customer.phone}}</span>
                        {{/if}}
                        {{#if customer360.customer.email}}
                        <span>{{customer360.customer.email}}</span>
                        {{/if}}
                        {{#if customer360.customer.city}}
                        <span>{{customer360.customer.city}}</span>
                        {{/if}}
                    </div>
                </div>
            </div>

            <div class="customer-360-classifications">
                <div class="customer-360-classification">
                    <span>Customer Segment</span>
                    <strong>{{customer360.customer.segment}}</strong>
                </div>
                <div class="customer-360-classification">
                    <span>RFM Classification</span>
                    <strong>{{customer360.customer.rfmSegment}}</strong>
                </div>
                <div class="customer-360-classification">
                    <span>Customer Since</span>
                    <strong>{{customer360.customer.customerSince}}</strong>
                </div>
            </div>
        </div>

        <div class="customer-360-kpi-grid">
            <article class="customer-360-kpi-card">
                <span>Lifetime Revenue</span>
                <strong>{{customer360.formattedLifetimeRevenue}}</strong>
                <small>Total completed customer sales</small>
            </article>

            <article class="customer-360-kpi-card">
                <span>Gross Profit</span>
                <strong>{{customer360.formattedGrossProfit}}</strong>
                <small>Revenue less historical item cost</small>
            </article>

            <article class="customer-360-kpi-card">
                <span>Total Purchases</span>
                <strong>{{customer360.totalPurchases}}</strong>
                <small>Completed transactions</small>
            </article>

            <article class="customer-360-kpi-card">
                <span>Average Order Value</span>
                <strong>{{customer360.formattedAverageOrderValue}}</strong>
                <small>Average completed transaction</small>
            </article>

            <article class="customer-360-kpi-card">
                <span>Last Purchase</span>
                <strong>{{customer360.lastPurchase}}</strong>
                <small>{{customer360.daysSinceLastPurchase}} days since last purchase</small>
            </article>

            <article class="customer-360-kpi-card">
                <span>Gross Margin</span>
                <strong>{{customer360.formattedGrossMargin}}%</strong>
                <small>Gross profit as a share of revenue</small>
            </article>
        </div>

        <div class="customer-360-main-grid">
            <article class="customer-panel customer-360-panel">
                <div class="customer-panel-header">
                    <div>
                        <h3>Purchase Trend</h3>
                        <p>Track the customer's purchasing activity over time.</p>
                    </div>
                </div>
                <div class="customer-360-chart-container">
                    <canvas id="customer360PurchaseTrendChart"></canvas>
                </div>
            </article>

            <article class="customer-panel customer-360-panel">
                <div class="customer-panel-header">
                    <div>
                        <h3>Customer Financial Profile</h3>
                        <p>Revenue, cost of goods, and gross profit.</p>
                    </div>
                </div>
                <div class="customer-360-chart-container">
                    <canvas id="customer360ProfitabilityChart"></canvas>
                </div>
            </article>
        </div>

        <div class="customer-360-insights-grid">
            <article class="customer-panel customer-360-panel">
                <div class="customer-panel-header">
                    <div>
                        <h3>Buying Behavior</h3>
                        <p>Understand what this customer purchases.</p>
                    </div>
                </div>

                <div class="customer-360-behavior-list">
                    <div class="customer-360-behavior-row">
                        <span>Preferred Product</span>
                        <strong>{{customer360.buyingBehavior.preferredProduct}}</strong>
                    </div>
                    <div class="customer-360-behavior-row">
                        <span>Preferred Category</span>
                        <strong>{{customer360.buyingBehavior.preferredCategory}}</strong>
                    </div>
                    <div class="customer-360-behavior-row">
                        <span>Total Quantity Purchased</span>
                        <strong>{{customer360.buyingBehavior.totalQuantity}}</strong>
                    </div>
                    <div class="customer-360-behavior-row">
                        <span>Purchase Frequency</span>
                        <strong>{{customer360.buyingBehavior.purchaseFrequency}}</strong>
                    </div>
                    <div class="customer-360-behavior-row">
                        <span>First Purchase</span>
                        <strong>{{customer360.firstPurchase}}</strong>
                    </div>
                </div>
            </article>

            <article class="customer-panel customer-360-panel">
                <div class="customer-panel-header">
                    <div>
                        <h3>Customer Profitability</h3>
                        <p>Evaluate the customer's financial contribution.</p>
                    </div>
                </div>

                <div class="customer-360-profitability-list">
                    <div class="customer-360-profitability-row">
                        <span>Total Revenue</span>
                        <strong>{{customer360.formattedLifetimeRevenue}}</strong>
                    </div>
                    <div class="customer-360-profitability-row">
                        <span>Cost of Goods Sold</span>
                        <strong>{{customer360.formattedCOGS}}</strong>
                    </div>
                    <div class="customer-360-profitability-row">
                        <span>Gross Profit</span>
                        <strong>{{customer360.formattedGrossProfit}}</strong>
                    </div>
                    <div class="customer-360-profitability-row">
                        <span>Gross Margin</span>
                        <strong>{{customer360.formattedGrossMargin}}%</strong>
                    </div>
                    <div class="customer-360-profitability-row">
                        <span>Average Profit per Purchase</span>
                        <strong>{{customer360.formattedAverageProfitPerPurchase}}</strong>
                    </div>
                </div>
            </article>
        </div>

        <article class="customer-panel customer-360-history-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Purchase History</h3>
                    <p>Review completed transactions for this customer.</p>
                </div>
                <span class="customer-360-record-count">
                    {{customer360.purchaseHistory.length}} records
                </span>
            </div>

            <div class="customer-table-wrapper">
                <table class="customer-data-table customer-360-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Invoice</th>
                            <th>Branch</th>
                            <th>Items</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Payment Method</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each customer360.purchaseHistory}}
                        <tr>
                            <td>{{date}}</td>
                            <td>{{invoiceNumber}}</td>
                            <td>{{branchName}}</td>
                            <td>{{itemCount}}</td>
                            <td>{{formattedSubtotal}}</td>
                            <td>{{formattedDiscount}}</td>
                            <td class="customer-360-purchase-total">{{formattedTotal}}</td>
                            <td>{{paymentMethod}}</td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="8" class="customer-table-empty">
                                No completed purchase history is available.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </article>

        <article class="customer-panel customer-360-timeline-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Customer Timeline</h3>
                    <p>A chronological view of significant customer activity.</p>
                </div>
            </div>

            <div class="customer-360-timeline">
                {{#each customer360.timeline}}
                <div class="customer-360-timeline-item">
                    <div class="customer-360-timeline-marker"></div>
                    <div class="customer-360-timeline-content">
                        <div class="customer-360-timeline-heading">
                            <strong>{{title}}</strong>
                            <span>{{date}}</span>
                        </div>
                        <p>{{description}}</p>
                        {{#if formattedAmount}}
                        <strong class="customer-360-timeline-amount">{{formattedAmount}}</strong>
                        {{/if}}
                    </div>
                </div>
                {{else}}
                <div class="customer-360-empty">
                    No customer timeline events are available.
                </div>
                {{/each}}
            </div>
        </article>

        {{else}}
        <div class="customer-360-empty-state">
            <div class="customer-360-empty-icon">◎</div>
            <h3>Select a Customer</h3>
            <p>Open a customer profile to review their purchases, lifetime value, profitability, and activity history.</p>
            <p class="customer-360-empty-hint">
                Select a customer from your customer records and open their Customer 360 profile.
            </p>
        </div>
        {{/if}}
    {{else}}
        <div class="customer-360-empty-state">
            <div class="customer-360-empty-icon">◎</div>
            <h3>Customer Profile Unavailable</h3>
            <p>The customer profile could not be loaded for the current business and branch scope.</p>
        </div>
    {{/if}}
</section>

<!-- STEP 13: DECISION INTELLIGENCE -->
<section id="customer-decision-intelligence" class="customer-section">
    <div class="customer-section-header">
        <div>
            <span class="customer-section-eyebrow">EXECUTIVE DECISION SUPPORT</span>
            <h2>Decision Intelligence</h2>
            <p>Identify customer risks, growth opportunities, financial dependencies, and recommended management actions.</p>
        </div>
        <div class="customer-section-badge">
            <span class="customer-status-dot"></span>
            Executive Insights
        </div>
    </div>

    {{#if customerDecisionIntelligence}}

    <div class="customer-decision-summary">
        <div class="customer-decision-summary-content">
            <span class="customer-decision-summary-label">EXECUTIVE SUMMARY</span>
            <h3>{{customerDecisionIntelligence.executiveSummary.title}}</h3>
            <p>{{customerDecisionIntelligence.executiveSummary.description}}</p>
        </div>
        <div class="customer-decision-summary-status customer-decision-status-{{customerDecisionIntelligence.executiveSummary.statusClass}}">
            {{customerDecisionIntelligence.executiveSummary.status}}
        </div>
    </div>

    <div class="customer-decision-kpi-grid">
        <article class="customer-decision-kpi-card customer-decision-risk">
            <div class="customer-decision-kpi-top">
                <span>At-Risk Customers</span>
                <span class="customer-decision-kpi-icon">!</span>
            </div>
            <strong>{{customerDecisionIntelligence.atRiskCustomers.count}}</strong>
            <p>Customers showing potential disengagement</p>
            <div class="customer-decision-kpi-footer">
                <span>Associated Revenue</span>
                <strong>{{customerDecisionIntelligence.atRiskCustomers.formattedRevenue}}</strong>
            </div>
        </article>

        <article class="customer-decision-kpi-card customer-decision-dormant">
            <div class="customer-decision-kpi-top">
                <span>Dormant Customers</span>
                <span class="customer-decision-kpi-icon">◷</span>
            </div>
            <strong>{{customerDecisionIntelligence.dormantCustomers.count}}</strong>
            <p>Customers with extended purchasing inactivity</p>
            <div class="customer-decision-kpi-footer">
                <span>Associated Revenue</span>
                <strong>{{customerDecisionIntelligence.dormantCustomers.formattedRevenue}}</strong>
            </div>
        </article>

        <article class="customer-decision-kpi-card customer-decision-growth">
            <div class="customer-decision-kpi-top">
                <span>High-Value Customers</span>
                <span class="customer-decision-kpi-icon">↗</span>
            </div>
            <strong>{{customerDecisionIntelligence.highValueCustomers.count}}</strong>
            <p>Customers with significant financial contribution</p>
            <div class="customer-decision-kpi-footer">
                <span>Associated Revenue</span>
                <strong>{{customerDecisionIntelligence.highValueCustomers.formattedRevenue}}</strong>
            </div>
        </article>

        <article class="customer-decision-kpi-card customer-decision-profit">
            <div class="customer-decision-kpi-top">
                <span>High-Value Gross Profit</span>
                <span class="customer-decision-kpi-icon">◆</span>
            </div>
            <strong>{{customerDecisionIntelligence.highValueCustomers.formattedGrossProfit}}</strong>
            <p>Gross profit associated with high-value customers</p>
            <div class="customer-decision-kpi-footer">
                <span>Customer Count</span>
                <strong>{{customerDecisionIntelligence.highValueCustomers.count}}</strong>
            </div>
        </article>
    </div>

    <div class="customer-decision-performance-grid">
        <article class="customer-panel customer-decision-performance-card">
            <div class="customer-panel-header">
                <div>
                    <h3>Customer Growth</h3>
                    <p>Acquisition performance and direction.</p>
                </div>
                <span class="customer-decision-direction customer-direction-{{customerDecisionIntelligence.customerGrowth.directionClass}}">
                    {{customerDecisionIntelligence.customerGrowth.direction}}
                </span>
            </div>
            <strong class="customer-decision-performance-value">
                {{customerDecisionIntelligence.customerGrowth.newCustomers}}
            </strong>
            <span class="customer-decision-performance-caption">New customers in the selected period</span>
            <p>{{customerDecisionIntelligence.customerGrowth.insight}}</p>
        </article>

        <article class="customer-panel customer-decision-performance-card">
            <div class="customer-panel-header">
                <div>
                    <h3>Customer Retention</h3>
                    <p>Repeat purchasing performance.</p>
                </div>
                <span class="customer-decision-direction customer-direction-{{customerDecisionIntelligence.retention.directionClass}}">
                    {{customerDecisionIntelligence.retention.direction}}
                </span>
            </div>
            <strong class="customer-decision-performance-value">
                {{customerDecisionIntelligence.retention.formattedRepeatPurchaseRate}}%
            </strong>
            <span class="customer-decision-performance-caption">Repeat purchase rate</span>
            <p>{{customerDecisionIntelligence.retention.insight}}</p>
        </article>

        <article class="customer-panel customer-decision-performance-card">
            <div class="customer-panel-header">
                <div>
                    <h3>Revenue Concentration</h3>
                    <p>Exposure to the largest customers.</p>
                </div>
                <span class="customer-decision-direction customer-direction-{{customerDecisionIntelligence.concentration.directionClass}}">
                    {{customerDecisionIntelligence.concentration.direction}}
                </span>
            </div>
            <strong class="customer-decision-performance-value">
                {{customerDecisionIntelligence.concentration.formattedTop10Percentage}}%
            </strong>
            <span class="customer-decision-performance-caption">Revenue contributed by the top 10 customers</span>
            <p>{{customerDecisionIntelligence.concentration.insight}}</p>
        </article>

        <article class="customer-panel customer-decision-performance-card">
            <div class="customer-panel-header">
                <div>
                    <h3>Branch Performance</h3>
                    <p>Leading branch by customer revenue.</p>
                </div>
            </div>
            <strong class="customer-decision-performance-value customer-decision-branch-name">
                {{customerDecisionIntelligence.branchPerformance.topBranchName}}
            </strong>
            <span class="customer-decision-performance-caption">
                {{customerDecisionIntelligence.branchPerformance.formattedRevenue}} revenue
            </span>
            <p>{{customerDecisionIntelligence.branchPerformance.insight}}</p>
        </article>
    </div>

    <div class="customer-decision-main-grid">
        <article class="customer-panel customer-decision-insights-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Management Insights</h3>
                    <p>Signals requiring attention or presenting opportunities.</p>
                </div>
            </div>

            <div class="customer-decision-insights-list">
                {{#each customerDecisionIntelligence.insights}}
                <div class="customer-decision-insight customer-insight-{{severityClass}}">
                    <div class="customer-decision-insight-indicator"></div>
                    <div class="customer-decision-insight-content">
                        <div class="customer-decision-insight-heading">
                            <h4>{{title}}</h4>
                            <span>{{severity}}</span>
                        </div>
                        <p>{{description}}</p>
                        {{#if implication}}
                        <div class="customer-decision-implication">
                            <strong>Business implication:</strong>
                            {{implication}}
                        </div>
                        {{/if}}
                        {{#if recommendation}}
                        <div class="customer-decision-recommendation">
                            <strong>Recommended action:</strong>
                            {{recommendation}}
                        </div>
                        {{/if}}
                    </div>
                </div>
                {{else}}
                <div class="customer-decision-empty">
                    No management insights are available for the current selection.
                </div>
                {{/each}}
            </div>
        </article>

        <article class="customer-panel customer-decision-actions-panel">
            <div class="customer-panel-header">
                <div>
                    <h3>Priority Actions</h3>
                    <p>Recommended next steps for management.</p>
                </div>
            </div>

            <div class="customer-decision-actions-list">
                {{#each customerDecisionIntelligence.recommendations}}
                <div class="customer-decision-action">
                    <div class="customer-decision-action-number">{{priority}}</div>
                    <div class="customer-decision-action-content">
                        <h4>{{title}}</h4>
                        <p>{{description}}</p>
                        {{#if expectedImpact}}
                        <span class="customer-decision-action-impact">
                            Expected impact: {{expectedImpact}}
                        </span>
                        {{/if}}
                    </div>
                </div>
                {{else}}
                <div class="customer-decision-empty">
                    No priority actions are available.
                </div>
                {{/each}}
            </div>
        </article>
    </div>

    <article class="customer-panel customer-decision-watchlist-panel">
        <div class="customer-panel-header">
            <div>
                <h3>Customer Risk Watchlist</h3>
                <p>Customers identified as at risk or dormant who may benefit from targeted engagement.</p>
            </div>
            <span class="customer-decision-watchlist-count">
                {{customerDecisionIntelligence.customerWatchlist.length}} customers
            </span>
        </div>

        <div class="customer-table-wrapper">
            <table class="customer-data-table customer-decision-watchlist-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Customer Code</th>
                        <th>Segment</th>
                        <th>Last Purchase</th>
                        <th>Days Inactive</th>
                        <th>Transactions</th>
                        <th>Lifetime Revenue</th>
                        <th>Gross Profit</th>
                        <th>Risk Level</th>
                        <th>Suggested Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each customerDecisionIntelligence.customerWatchlist}}
                    <tr>
                        <td class="customer-decision-watchlist-name">{{customerName}}</td>
                        <td>{{customerCode}}</td>
                        <td>{{segment}}</td>
                        <td>{{lastPurchase}}</td>
                        <td>{{daysInactive}}</td>
                        <td>{{totalTransactions}}</td>
                        <td>{{formattedRevenue}}</td>
                        <td>{{formattedGrossProfit}}</td>
                        <td>
                            <span class="customer-decision-risk-label customer-risk-{{riskClass}}">
                                {{riskLevel}}
                            </span>
                        </td>
                        <td>{{suggestedAction}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="10" class="customer-table-empty">
                            No customers currently appear on the risk watchlist.
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </article>

    {{else}}
    <div class="customer-empty-state">
        <h3>Decision intelligence unavailable</h3>
        <p>Executive insights could not be loaded for the selected business, branch, or period.</p>
    </div>
    {{/if}}
</section>

</main>

</body>
</html>