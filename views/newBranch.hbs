<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <link rel="stylesheet" href="/newBranch.css">
</head>
<body>
    <div class="branch-page">
        <header class="branch-page-header">
            <div class="branch-header-left">
                <div class="branch-header-icon">
                    <i class="fa-solid fa-code-branch"></i>
                </div>

                <div>
                    <h1>New Branch</h1>
                    <p>Create and manage branches for your business.</p>
                </div>
            </div>

            <a href="/" class="branch-back-btn">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard
            </a>
        </header>

        <main class="branch-page-content">
            <section class="branch-business-card">
                <div class="branch-section-heading">
                    <div>
                        <span class="section-label">BUSINESS</span>
                        <h2>{{business.business_name}}</h2>
                    </div>

                    <span class="business-status">
                        <i class="fa-solid fa-circle"></i>
                        Active
                    </span>
                </div>

                <div class="business-details">
                    {{#if business.email}}
                        <div class="business-detail">
                            <i class="fa-solid fa-envelope"></i>
                            <span>{{business.email}}</span>
                        </div>
                    {{/if}}

                    {{#if business.phone}}
                        <div class="business-detail">
                            <i class="fa-solid fa-phone"></i>
                            <span>{{business.phone}}</span>
                        </div>
                    {{/if}}

                    {{#if business.city}}
                        <div class="business-detail">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>{{business.city}}</span>
                        </div>
                    {{/if}}
                </div>
            </section>

            <div id="branchMessage" class="branch-message" role="alert" aria-live="polite"></div>

            <div class="branch-layout">
                <section class="branch-form-card">
                    <div class="card-header">
                        <div class="card-header-icon">
                            <i class="fa-solid fa-plus"></i>
                        </div>

                        <div>
                            <h2>Create New Branch</h2>
                            <p>Add another operating location to your business.</p>
                        </div>
                    </div>

                    <form id="newBranchForm" novalidate>
                        <div class="form-group">
                            <label for="branchName">
                                Branch Name
                                <span>*</span>
                            </label>

                            <input
                                type="text"
                                id="branchName"
                                name="branch_name"
                                placeholder="e.g. Accra Central Branch"
                                maxlength="150"
                                autocomplete="organization"
                                required
                            >

                            <small>
                                Enter a unique name for this branch.
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="branchLocation">
                                Branch Location
                            </label>

                            <input
                                type="text"
                                id="branchLocation"
                                name="branch_location"
                                placeholder="e.g. Accra Central, Greater Accra"
                                maxlength="255"
                                autocomplete="street-address"
                            >
                        </div>

                        <div class="form-group">
                            <label for="branchPhone">
                                Branch Phone
                            </label>

                            <input
                                type="tel"
                                id="branchPhone"
                                name="branch_phone"
                                placeholder="e.g. 024 000 0000"
                                maxlength="50"
                                autocomplete="tel"
                            >
                        </div>

                        <div class="form-actions">
                            <button
                                type="button"
                                id="clearBranchFormBtn"
                                class="secondary-btn"
                            >
                                <i class="fa-solid fa-rotate-left"></i>
                                Clear
                            </button>

                            <button
                                type="submit"
                                id="createBranchBtn"
                                class="primary-btn"
                            >
                                <i class="fa-solid fa-plus"></i>
                                Create Branch
                            </button>
                        </div>
                    </form>
                </section>

                <section class="branch-list-card">
                    <div class="card-header">
                        <div class="card-header-icon">
                            <i class="fa-solid fa-building"></i>
                        </div>

                        <div>
                            <h2>Existing Branches</h2>
                            <p>Branches currently belonging to this business.</p>
                        </div>
                    </div>

                    <div id="branchesContainer" class="branches-container">
                        {{#if branches.length}}
                            {{#each branches}}
                                <div
                                    class="branch-item"
                                    data-branch-id="{{branch_id}}"
                                >
                                    <div class="branch-item-icon">
                                        <i class="fa-solid fa-code-branch"></i>
                                    </div>

                                    <div class="branch-item-content">
                                        <h3>{{branch_name}}</h3>

                                        {{#if location}}
                                            <p>
                                                <i class="fa-solid fa-location-dot"></i>
                                                {{location}}
                                            </p>
                                        {{/if}}

                                        {{#if phone}}
                                            <p>
                                                <i class="fa-solid fa-phone"></i>
                                                {{phone}}
                                            </p>
                                        {{/if}}
                                    </div>

                                    <div class="branch-item-status">
                                        {{#if is_active}}
                                            <span class="active-status">
                                                <i class="fa-solid fa-circle"></i>
                                                Active
                                            </span>
                                        {{else}}
                                            <span class="inactive-status">
                                                <i class="fa-solid fa-circle"></i>
                                                Inactive
                                            </span>
                                        {{/if}}
                                    </div>
                                </div>
                            {{/each}}
                        {{else}}
                            <div id="emptyBranchesState" class="empty-branches-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-code-branch"></i>
                                </div>

                                <h3>No Additional Branches</h3>
                                <p>
                                    Create a new branch using the form to get started.
                                </p>
                            </div>
                        {{/if}}
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script src="/js/newBranch.js"></script>
</body>
</html>