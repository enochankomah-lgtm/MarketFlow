<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create MarketFlow Account</title>

    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Account.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>

<div class="register-wrapper">

    <!-- =========================================================
         LEFT PANEL
    ========================================================== -->

    <section class="left-panel">

        <div class="brand">

            <div class="logo-box">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>

            <div>
                <h2>MarketFlow</h2>
                <span>Market Management System</span>
            </div>

        </div>


        <div class="welcome-section">

            <span class="eyebrow">
                BUSINESS MANAGEMENT PLATFORM
            </span>

            <h1>
                Join your business on MarketFlow.
            </h1>

            <p>
                Create your account and connect to the business
                and branch where you work.
            </p>

        </div>


        <div class="dashboard-card">

            <img
                src="https://images.pexels.com/photos/18471529/pexels-photo-18471529.jpeg"
                alt="MarketFlow business management">

        </div>


        <div class="feature-list">

            <div class="feature-item">

                <i class="fa-solid fa-shield-halved"></i>

                <div>
                    <h4>Secure System</h4>
                    <p>Your business data is protected.</p>
                </div>

            </div>


            <div class="feature-item">

                <i class="fa-solid fa-chart-line"></i>

                <div>
                    <h4>Business Analytics</h4>
                    <p>Track your business performance.</p>
                </div>

            </div>


            <div class="feature-item">

                <i class="fa-solid fa-users"></i>

                <div>
                    <h4>Staff Management</h4>
                    <p>Manage users and responsibilities.</p>
                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         RIGHT PANEL
    ========================================================== -->

    <section class="right-panel">
        <div class="register-card">
            <div class="form-header">
                <div class="header-top">
                    <div>
                        <span class="form-eyebrow">
                            MARKETFLOW ACCOUNT
                        </span>
                        <h2>Create Your Account</h2>
                    </div>


                    <button
                        type="button"
                        class="home-btn"
                        onclick="window.location.href='/'">

                        <i class="fa-solid fa-house"></i>
                        Home

                    </button>

                </div>


                <p>
                    Create your account and request access to
                    your business and branch.
                </p>

            </div>



            <!-- =====================================================
                 REGISTRATION FORM
            ====================================================== -->

            <form id="registrationForm" method="POST" action="/auth/register" >


                <!-- =================================================
                     PERSONAL INFORMATION
                ================================================== -->

                <div class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            <h3>Personal Information</h3>
                            <p>Your personal account details</p>
                        </div>

                    </div>


                    <div class="form-grid">


                        <!-- FIRST NAME -->

                        <div class="form-group">

                            <label for="firstName">
                                First Name
                            </label>

                            <input
                                type="text"
                                id="firstName"
                                name="firstName"
                                value="{{firstName}}"
                                placeholder="Enter first name"
                                autocomplete="given-name"
                                required
                            >

                        </div>



                        <!-- LAST NAME -->

                        <div class="form-group">

                            <label for="lastName">
                                Last Name
                            </label>

                            <input
                                type="text"
                                id="lastName"
                                name="lastName"
                                value="{{lastName}}"
                                placeholder="Enter last name"
                                autocomplete="family-name"
                                required
                            >

                        </div>



                        <!-- EMAIL -->

                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="{{email}}"
                                placeholder="you@example.com"
                                autocomplete="email"
                                required
                            >

                        </div>



                        <!-- PHONE -->

                        <div class="form-group">

                            <label for="phone">
                                Phone Number
                            </label>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                value="{{phone}}"
                                placeholder="Enter phone number"
                                autocomplete="tel"
                                required
                            >

                        </div>



                        <!-- JOB TITLE -->

                        <div class="form-group full-width">

                            <label for="jobTitle">
                                Job Title
                            </label>

                            <input
                                type="text"
                                id="jobTitle"
                                name="jobTitle"
                                value="{{jobTitle}}"
                                placeholder="e.g. Sales Clerk"
                                required
                            >

                        </div>
                        <div class="form-group">
                            <label for="RoleName">Account Role</label>

                            <div class="input-icon">
                                <i class="fa-solid fa-user-shield"></i>

                                <select id="RoleName" name="RoleName" required>
                                    <option value="">Select your role</option>
                                    <option value="Cashier">Cashier</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Administrator">Administrator</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>

                            <small class="form-help">
                                Select the role assigned to you in your business.
                            </small>
                        </div>

                    </div>

                </div>



                <!-- =================================================
                     BUSINESS & BRANCH
                ================================================== -->

                <div class="form-section business-section">

                    <div class="section-heading">

                        <div class="section-icon business-icon">
                            <i class="fa-solid fa-building"></i>
                        </div>

                        <div>

                            <div class="section-title-row">

                                <h3>
                                    Business &amp; Branch
                                </h3>

                                <span class="required-badge">
                                    Required
                                </span>

                            </div>

                            <p>
                                Select the business and branch where
                                your account belongs.
                            </p>

                        </div>

                    </div>



                    <!-- INFORMATION NOTICE -->

                    <div class="business-notice">

                        <i class="fa-solid fa-circle-info"></i>

                        <span>
                            Select the business where you work and
                            then choose your active branch.
                        </span>

                    </div>



                    <!-- APPROVAL NOTICE -->

                    <div class="business-notice approval-notice">

                        <i class="fa-solid fa-clock"></i>

                        <span>
                            Your account will remain inactive until
                            a business administrator approves your
                            registration and assigns your appropriate
                            role.
                        </span>

                    </div>



                    <div class="form-grid">


                        <!-- BUSINESS -->

                        <div class="form-group">

                            <label for="business_id">
                                Business
                            </label>

                            <div class="input-icon">

                                <i class="fa-solid fa-building"></i>

                                <select
                                    id="business_id"
                                    name="business_id"
                                    required
                                >

                                    <option value="">
                                        Select your business
                                    </option>

                                    {{#each businesses}}

                                        <option
                                            value="{{business_id}}"
                                            data-location="{{address}}{{#if city}}, {{city}}{{/if}}"
                                            {{#ifEquals ../business_id business_id}}
                                                selected
                                            {{/ifEquals}}
                                        >
                                            {{business_name}}
                                        </option>

                                    {{/each}}

                                </select>

                            </div>

                        </div>



                        <!-- BRANCH -->

                        <div class="form-group">

                            <label for="branch_id">
                                Branch
                            </label>

                            <div class="input-icon">

                                <i class="fa-solid fa-code-branch"></i>

                                <select
                                    id="branch_id"
                                    name="branch_id"
                                    required
                                    disabled
                                >

                                    <option value="">
                                        Select a business first
                                    </option>

                                    {{#each branches}}

                                        <option
                                            value="{{branch_id}}"
                                            data-business-id="{{business_id}}"
                                            {{#ifEquals ../branch_id branch_id}}
                                                selected
                                            {{/ifEquals}}
                                        >
                                            {{branch_name}}
                                            {{#if location}}
                                                — {{location}}
                                            {{/if}}
                                        </option>

                                    {{/each}}

                                </select>

                            </div>

                        </div>



                        <!-- BUSINESS LOCATION -->

                        <div class="form-group full-width">

                            <label for="businessLocation">
                                Business Location
                            </label>

                            <div class="input-icon">

                                <i class="fa-solid fa-location-dot"></i>

                                <input
                                    type="text"
                                    id="businessLocation"
                                    value=""
                                    placeholder="Business location"
                                    readonly
                                >

                            </div>

                            <small class="form-help">
                                Business information is loaded from
                                MarketFlow and cannot be edited here.
                            </small>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     PASSWORD
                ================================================== -->

                <div class="form-grid">

                    <div class="form-group">

                        <label for="password">
                            Password
                        </label>

                        <div class="password-input-wrapper">

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Create a password"
                                minlength="8"
                                autocomplete="new-password"
                                required
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                data-target="password"
                                aria-label="Show password"
                            >

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                    </div>



                    <!-- CONFIRM PASSWORD -->

                    <div class="form-group">

                        <label for="confirmPassword">
                            Confirm Password
                        </label>

                        <div class="password-input-wrapper">

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="Confirm your password"
                                minlength="8"
                                autocomplete="new-password"
                                required
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                data-target="confirmPassword"
                                aria-label="Show password"
                            >

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     TERMS
                ================================================== -->

                <div class="terms">

                    <input
                        type="checkbox"
                        id="terms"
                        name="terms"
                        required
                    >

                    <label for="terms">

                        I agree to the MarketFlow Terms &amp; Conditions
                        and confirm that I am joining the selected
                        business and branch.

                    </label>

                </div>



                <!-- =================================================
                     SERVER MESSAGE
                ================================================== -->

                {{#if message}}

                    <div class="message">

                        <i class="fa-solid fa-circle-exclamation"></i>

                        <span>
                            {{message}}
                        </span>

                    </div>

                {{/if}}



                <!-- =================================================
                     SUBMIT
                ================================================== -->

                <button
                    type="submit"
                    class="register-btn"
                >

                    <i class="fa-solid fa-user-plus"></i>

                    Create Account

                </button>



                <div class="signin-link">

                    Already have an account?

                    <a href="/login">
                        Sign In
                    </a>

                </div>


            </form>

        </div>

    </section>

</div>



<script>

document.addEventListener("DOMContentLoaded", function () {

    const registrationForm =
        document.getElementById("registrationForm");

    const businessSelect =
        document.getElementById("business_id");

    const branchSelect =
        document.getElementById("branch_id");

    const locationInput =
        document.getElementById("businessLocation");


    if (!businessSelect || !branchSelect) {
        return;
    }



    // Store all branches before filtering them
    const allBranches =
        Array.from(branchSelect.options)
            .filter(option => option.value !== "")
            .map(option => ({
                value: option.value,
                text: option.textContent.trim(),
                businessId: option.dataset.businessId || ""
            }));



    function updateBranches() {

        const businessId =
            businessSelect.value;

        const previousBranchId =
            branchSelect.dataset.selectedBranch || "";



        branchSelect.innerHTML = "";



        if (!businessId) {

            const option =
                document.createElement("option");

            option.value = "";

            option.textContent =
                "Select a business first";

            branchSelect.appendChild(option);

            branchSelect.disabled = true;


            if (locationInput) {
                locationInput.value = "";
            }

            return;
        }



        branchSelect.disabled = false;



        const defaultOption =
            document.createElement("option");

        defaultOption.value = "";

        defaultOption.textContent =
            "Select your branch";

        branchSelect.appendChild(defaultOption);



        let matchingBranches = 0;



        allBranches.forEach(branch => {

            if (
                String(branch.businessId) !==
                String(businessId)
            ) {
                return;
            }



            const option =
                document.createElement("option");

            option.value = branch.value;

            option.textContent = branch.text;

            option.dataset.businessId =
                branch.businessId;



            if (
                previousBranchId &&
                String(previousBranchId) ===
                String(branch.value)
            ) {
                option.selected = true;
            }



            branchSelect.appendChild(option);

            matchingBranches++;

        });



        if (matchingBranches === 0) {

            const option =
                document.createElement("option");

            option.value = "";

            option.textContent =
                "No active branches available";

            branchSelect.appendChild(option);

            branchSelect.disabled = true;

        }



        const selectedBusiness =
            businessSelect.options[
                businessSelect.selectedIndex
            ];



        if (locationInput && selectedBusiness) {

            locationInput.value =
                selectedBusiness.dataset.location || "";

        }

    }



    // Preserve branch selected after server validation error
    branchSelect.dataset.selectedBranch =
        "{{branch_id}}";



    businessSelect.addEventListener(
        "change",
        function () {

            branchSelect.dataset.selectedBranch = "";

            updateBranches();

        }
    );



    if (registrationForm) {

        registrationForm.addEventListener(
            "submit",
            function (event) {

                const businessId =
                    businessSelect.value;

                const branchId =
                    branchSelect.value;



                if (!businessId) {

                    event.preventDefault();

                    alert(
                        "Please select a business."
                    );

                    businessSelect.focus();

                    return;

                }



                if (
                    !branchId ||
                    branchSelect.disabled
                ) {

                    event.preventDefault();

                    alert(
                        "Please select a valid branch."
                    );

                    branchSelect.focus();

                    return;

                }



                const selectedBranch =
                    branchSelect.options[
                        branchSelect.selectedIndex
                    ];



                if (
                    !selectedBranch ||
                    String(selectedBranch.dataset.businessId) !==
                    String(businessId)
                ) {

                    event.preventDefault();

                    alert(
                        "The selected branch does not belong " +
                        "to the selected business."
                    );

                    branchSelect.focus();

                    return;

                }



                validatePasswords();



                if (!registrationForm.checkValidity()) {

                    event.preventDefault();

                }

            }
        );

    }



    updateBranches();

});



function validatePasswords() {

    const password =
        document.getElementById("password");

    const confirmPassword =
        document.getElementById("confirmPassword");



    if (!password || !confirmPassword) {
        return;
    }



    if (
        confirmPassword.value !==
        password.value
    ) {

        confirmPassword.setCustomValidity(
            "Passwords do not match."
        );

    } else {

        confirmPassword.setCustomValidity("");

    }

}



document.addEventListener(
    "DOMContentLoaded",
    function () {

        const passwordToggles =
            document.querySelectorAll(
                ".password-toggle"
            );



        passwordToggles.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const targetId =
                            button.dataset.target;

                        const passwordInput =
                            document.getElementById(
                                targetId
                            );

                        const icon =
                            button.querySelector("i");



                        if (!passwordInput) {
                            return;
                        }



                        if (
                            passwordInput.type ===
                            "password"
                        ) {

                            passwordInput.type =
                                "text";

                            icon.classList.remove(
                                "fa-eye"
                            );

                            icon.classList.add(
                                "fa-eye-slash"
                            );

                            button.setAttribute(
                                "aria-label",
                                "Hide password"
                            );

                        } else {

                            passwordInput.type =
                                "password";

                            icon.classList.remove(
                                "fa-eye-slash"
                            );

                            icon.classList.add(
                                "fa-eye"
                            );

                            button.setAttribute(
                                "aria-label",
                                "Show password"
                            );

                        }

                    }
                );

            }
        );

    }
);

</script>

</body>
</html>