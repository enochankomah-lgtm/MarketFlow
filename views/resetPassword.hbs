
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="theme-color" content="#166534">
    <meta name="referrer" content="no-referrer">

    <title>Reset Password - MarketFlow</title>

    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/login.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >
</head>

<body>

<div class="login-wrapper">

    <!-- =========================================================
         LEFT PANEL
    ========================================================== -->

    <section class="left-panel">

        <div class="brand">

            <div class="logo-box">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>

            <div>
                <h2>MarketFlow</h2>
                <span>Market Management System</span>
            </div>

        </div>


        <div class="welcome-section">

            <span class="eyebrow">
                ACCOUNT SECURITY
            </span>

            <h1>
                A fresh start for your account.
            </h1>

            <p>
                Create a new password and get back to managing
                your products, sales, inventory and business.
            </p>

        </div>


        <div class="dashboard-card">

            <img
                src="https://images.pexels.com/photos/18471529/pexels-photo-18471529.jpeg"
                alt="MarketFlow business management"
            >

        </div>


        <div class="feature-list">

            <div class="feature-item">

                <i class="fa-solid fa-shield-halved"></i>

                <div>
                    <h4>Secure Account</h4>
                    <p>Your password is protected with encryption.</p>
                </div>

            </div>


            <div class="feature-item">

                <i class="fa-solid fa-key"></i>

                <div>
                    <h4>New Password</h4>
                    <p>Choose a password known only to you.</p>
                </div>

            </div>


            <div class="feature-item">

                <i class="fa-solid fa-lock"></i>

                <div>
                    <h4>Protected Access</h4>
                    <p>Your reset link can only be used once.</p>
                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         RIGHT PANEL
    ========================================================== -->

    <section class="right-panel">

        <div class="login-card">

            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="form-header">

                <div class="header-top">

                    <div>

                        <span class="form-eyebrow">
                            MARKETFLOW ACCOUNT
                        </span>

                        <h2>
                            {{#if success}}
                                Password Updated
                            {{else}}
                                Reset Password
                            {{/if}}
                        </h2>

                    </div>


                    <button
                        type="button"
                        class="home-btn"
                        onclick="window.location.href='/login'"
                    >

                        <i class="fa-solid fa-arrow-left"></i>

                        Sign In

                    </button>

                </div>


                <p>
                    {{#if success}}
                        Your password has been changed successfully.
                    {{else}}
                        Create a new password to regain access
                        to your MarketFlow account.
                    {{/if}}
                </p>

            </div>



            <!-- =================================================
                 SUCCESS MESSAGE
            ================================================== -->

            {{#if success}}

                <div
                    class="message success-message"
                    role="status"
                    aria-live="polite"
                >

                    <i class="fa-solid fa-circle-check"></i>

                    <span>
                        {{success}}
                    </span>

                </div>


                <div class="create-account">

                    <span>
                        Your account is ready.
                    </span>

                    <a href="/login">
                        Sign In to MarketFlow
                    </a>

                </div>

            {{else}}



            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

                {{#if error}}

                    <div
                        class="message"
                        role="alert"
                        aria-live="assertive"
                    >

                        <i class="fa-solid fa-circle-exclamation"></i>

                        <span>
                            {{error}}
                        </span>

                    </div>

                {{/if}}



                <!-- =================================================
                     PASSWORD RESET FORM
                ================================================== -->

                {{#if token}}

                    <form
                        id="resetPasswordForm"
                        method="POST"
                        action="/auth/reset-password"
                    >

                        <!-- RESET TOKEN -->

                        <input
                            type="hidden"
                            name="token"
                            value="{{token}}"
                        >


                        <!-- NEW PASSWORD -->

                        <div class="form-group">

                            <label for="password">
                                New Password
                            </label>

                            <div class="password-input-wrapper">

                                <i class="fa-solid fa-lock password-icon"></i>

                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    placeholder="Enter your new password"
                                    autocomplete="new-password"
                                    minlength="8"
                                    required
                                >

                                <button
                                    type="button"
                                    class="password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password"
                                >

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                        </div>



                        <!-- CONFIRM PASSWORD -->

                        <div class="form-group">

                            <label for="confirmPassword">
                                Confirm New Password
                            </label>

                            <div class="password-input-wrapper">

                                <i class="fa-solid fa-lock password-icon"></i>

                                <input
                                    type="password"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    placeholder="Confirm your new password"
                                    autocomplete="new-password"
                                    minlength="8"
                                    required
                                >

                                <button
                                    type="button"
                                    class="password-toggle"
                                    id="confirmPasswordToggle"
                                    aria-label="Show password"
                                >

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                            <small
                                id="passwordMatchMessage"
                                style="
                                    display:none;
                                    margin-top:8px;
                                    color:#dc2626;
                                "
                            >
                                Passwords do not match.
                            </small>

                        </div>



                        <!-- PASSWORD REQUIREMENTS -->

                        <div style="
                            background:#f0fdf4;
                            border:1px solid #dcfce7;
                            border-radius:10px;
                            padding:13px 15px;
                            margin-bottom:22px;
                        ">

                            <div style="
                                font-size:13px;
                                font-weight:600;
                                color:#166534;
                                margin-bottom:8px;
                            ">
                                <i class="fa-solid fa-shield-halved"></i>
                                Password Requirements
                            </div>

                            <div style="
                                font-size:12px;
                                color:#475569;
                                line-height:1.9;
                            ">

                                <div>
                                    <i class="fa-solid fa-check"></i>
                                    At least 8 characters
                                </div>

                                <div>
                                    <i class="fa-solid fa-check"></i>
                                    Maximum 72 bytes
                                </div>

                                <div>
                                    <i class="fa-solid fa-check"></i>
                                    Use a password you haven't shared with anyone
                                </div>

                            </div>

                        </div>



                        <!-- SUBMIT BUTTON -->

                        <button
                            type="submit"
                            class="login-btn"
                            id="resetPasswordButton"
                        >

                            <i class="fa-solid fa-lock"></i>

                            <span>Update Password</span>

                        </button>


                    </form>

                {{else}}

                    <!-- =================================================
                         INVALID OR EXPIRED LINK
                    ================================================== -->

                    {{#unless error}}
                        <div class="message">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>
                                A valid password reset link is required.
                            </span>
                        </div>
                    {{/unless}}

                    <div class="create-account">

                        <span>
                            Need another reset link?
                        </span>

                        <a href="/auth/forgot-password">
                            Request a New Link
                        </a>

                    </div>

                {{/if}}

            {{/if}}


        </div>

    </section>

</div>



<!-- =========================================================
     PASSWORD FORM INTERACTIONS
========================================================== -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const passwordInput =
        document.getElementById("password");

    const confirmPasswordInput =
        document.getElementById("confirmPassword");

    const passwordToggle =
        document.getElementById("passwordToggle");

    const confirmPasswordToggle =
        document.getElementById("confirmPasswordToggle");

    const passwordMatchMessage =
        document.getElementById("passwordMatchMessage");

    const resetPasswordForm =
        document.getElementById("resetPasswordForm");

    const resetPasswordButton =
        document.getElementById("resetPasswordButton");


    /*
    |--------------------------------------------------------------------------
    | SHOW / HIDE PASSWORD
    |--------------------------------------------------------------------------
    */

    function setupPasswordToggle(input, button) {

        if (!input || !button) return;

        button.addEventListener("click", function () {

            const icon = button.querySelector("i");

            const showingPassword = input.type === "password";

            input.type = showingPassword ? "text" : "password";

            icon.classList.toggle("fa-eye", !showingPassword);
            icon.classList.toggle("fa-eye-slash", showingPassword);

            button.setAttribute(
                "aria-label",
                showingPassword ? "Hide password" : "Show password"
            );

        });

    }


    setupPasswordToggle(passwordInput, passwordToggle);

    setupPasswordToggle(
        confirmPasswordInput,
        confirmPasswordToggle
    );



    /*
    |--------------------------------------------------------------------------
    | PASSWORD MATCH VALIDATION
    |--------------------------------------------------------------------------
    */

    function validatePasswords() {

        if (!passwordInput || !confirmPasswordInput) {
            return true;
        }

        const password = passwordInput.value;

        const confirmation = confirmPasswordInput.value;

        const matches = password === confirmation;

        if (passwordMatchMessage) {

            passwordMatchMessage.style.display =
                confirmation.length > 0 && !matches
                    ? "block"
                    : "none";

        }

        confirmPasswordInput.setCustomValidity(
            matches ? "" : "Passwords do not match."
        );

        return matches;

    }


    if (passwordInput && confirmPasswordInput) {

        passwordInput.addEventListener(
            "input",
            validatePasswords
        );

        confirmPasswordInput.addEventListener(
            "input",
            validatePasswords
        );

    }



    /*
    |--------------------------------------------------------------------------
    | RESET FORM SUBMISSION
    |--------------------------------------------------------------------------
    */

    if (resetPasswordForm) {

        resetPasswordForm.addEventListener(
            "submit",
            function (event) {

                validatePasswords();

                if (!resetPasswordForm.checkValidity()) {

                    event.preventDefault();

                    resetPasswordForm.reportValidity();

                    return;

                }


                if (resetPasswordButton) {

                    resetPasswordButton.disabled = true;

                    resetPasswordButton.classList.add("loading");

                    resetPasswordButton.innerHTML = `
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Updating Password...</span>
                    `;

                }

            }
        );

    }

});

</script>

</body>
</html>
