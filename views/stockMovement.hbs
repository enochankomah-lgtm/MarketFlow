<section class="movement-card secondary-movement-card">

    <div class="card-header">

        <div class="card-heading">

            <span class="card-heading-icon">
                <i class="fa-solid fa-sliders"></i>
            </span>

            <div>

                <h2>
                    Stock Adjustment
                </h2>

                <p>
                    Increase or decrease stock manually.
                </p>

            </div>

        </div>

    </div>


    <form id="adjustStockForm" novalidate>
        <div class="form-grid">

            <!-- BRANCH -->

            <div class="form-group">
                <label for="adjustBranch">
                    Branch
                </label>

                <select
                    id="adjustBranch"
                    name="branch_id"
                    required
                >

                    <option value="">
                        Select branch
                    </option>

                </select>

            </div>


            <!-- PRODUCT -->

            <div class="form-group">

                <label for="adjustProduct">
                    Product
                </label>

                <select
                    id="adjustProduct"
                    name="product_id"
                    required
                    disabled
                >

                    <option value="">
                        Select product
                    </option>

                </select>

            </div>


            <!-- DIRECTION -->

            <div class="form-group">

                <label for="adjustDirection">
                    Direction
                </label>

                <select
                    id="adjustDirection"
                    name="direction"
                    required
                >

                    <option value="">
                        Select direction
                    </option>

                    <option value="IN">
                        Stock In
                    </option>

                    <option value="OUT">
                        Stock Out
                    </option>

                </select>

                <small class="form-help">
                    Stock In increases the branch stock.
                    Stock Out deducts from the branch stock.
                </small>

            </div>


            <!-- QUANTITY -->

            <div class="form-group">

                <label for="adjustQuantity">
                    Quantity
                </label>

                <input
                    type="number"
                    id="adjustQuantity"
                    name="quantity"
                    min="0.001"
                    step="0.001"
                    placeholder="0.000"
                    inputmode="decimal"
                    required
                >

                <small
                    id="adjustQuantityHelp"
                    class="form-help"
                >
                    Enter the quantity to adjust.
                </small>

            </div>


            <!-- REASON -->

            <div class="form-group full-width">

                <label for="adjustReason">
                    Reason
                </label>

                <input
                    type="text"
                    id="adjustReason"
                    name="reason"
                    maxlength="255"
                    placeholder="Reason for adjustment"
                    autocomplete="off"
                    required
                >

                <small class="form-help">
                    A reason is required for every stock adjustment.
                </small>

            </div>

        </div>


        <!-- SUBMIT -->

        <button
            type="submit"
            class="primary-btn"
        >

            <i class="fa-solid fa-sliders"></i>

            Adjust Stock

        </button>

    </form>

</section>

<section class="movement-card secondary-movement-card">

    <div class="card-header">

        <div class="card-heading">

            <span class="card-heading-icon danger-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </span>

            <div>

                <h2>
                    Stock Loss
                </h2>

                <p>
                    Remove stock that is damaged, spoiled, expired, lost, stolen or otherwise unavailable.
                </p>

            </div>

        </div>

    </div>


    <form id="stockLossForm" novalidate>

        <div class="form-grid">


            <!-- BRANCH -->

            <div class="form-group">

                <label for="lossBranch">
                    Branch
                </label>

                <select
                    id="lossBranch"
                    name="branch_id"
                    required
                >

                    <option value="">
                        Select branch
                    </option>

                </select>

            </div>


            <!-- PRODUCT -->

            <div class="form-group">

                <label for="lossProduct">
                    Product
                </label>

                <select
                    id="lossProduct"
                    name="product_id"
                    required
                    disabled
                >

                    <option value="">
                        Select product
                    </option>

                </select>

            </div>


            <!-- LOSS REASON -->

            <div class="form-group">
                <label for="lossType"> Reason </label>
                <select id="lossType" name="movement_type" required >
                    <option value=""> Select reason </option>
                    <option value="DAMAGE"> Damaged </option>

                    <option value="SPOILED">
                        Spoiled
                    </option>

                    <option value="EXPIRED">
                        Expired
                    </option>

                    <option value="LOST">
                        Lost
                    </option>

                    <option value="THEFT">
                        Theft
                    </option>

                    <option value="OTHER">
                        Other
                    </option>

                </select>

            </div>


            <!-- QUANTITY -->

            <div class="form-group">

                <label for="lossQuantity">
                    Quantity
                </label>

                <input
                    type="number"
                    id="lossQuantity"
                    name="quantity"
                    min="0.001"
                    step="0.001"
                    placeholder="0.000"
                    inputmode="decimal"
                    required
                >

                <small
                    class="form-help"
                    id="lossQuantityHelp"
                >
                    Enter the quantity to remove.
                </small>

            </div>


            <!-- NOTES -->

            <div class="form-group full-width">

                <label for="lossReason">
                    Notes
                </label>

                <input
                    type="text"
                    id="lossReason"
                    name="notes"
                    maxlength="255"
                    placeholder="Optional notes"
                    autocomplete="off"
                >

                <small class="form-help">
                    Add any additional information about this stock loss.
                </small>

            </div>

        </div>


        <!-- SUBMIT -->

        <button
            type="submit"
            class="danger-btn"
        >

            <i class="fa-solid fa-trash-can"></i>

            Remove Stock

        </button>

    </form>

</section>

<section class="movement-card secondary-movement-card">

    <div class="card-header">

        <div class="card-heading">

            <span class="card-heading-icon">
                <i class="fa-solid fa-rotate-left"></i>
            </span>

            <div>
                <h2>Returns</h2>

                <p>
                    Process customer and supplier stock returns.
                </p>
            </div>

        </div>

    </div>


    <form id="stockReturnForm" novalidate>

        <div class="form-grid">

            <div class="form-group">

                <label for="returnBranch">
                    Branch
                </label>

                <select
                    id="returnBranch"
                    name="branch_id"
                    required
                >
                    <option value="">
                        Select branch
                    </option>
                </select>

            </div>


            <div class="form-group">

                <label for="returnProduct">
                    Product
                </label>

                <select
                    id="returnProduct"
                    name="product_id"
                    required
                    disabled
                >
                    <option value="">
                        Select product
                    </option>
                </select>

            </div>


            <div class="form-group">

                <label for="returnType">
                    Return Type
                </label>

                <select
                    id="returnType"
                    name="return_type"
                    required
                >
                    <option value="">
                        Select return type
                    </option>

                    <option value="CUSTOMER_RETURN">
                        Customer Return
                    </option>

                    <option value="SUPPLIER_RETURN">
                        Supplier Return
                    </option>

                </select>

            </div>


            <div class="form-group">

                <label for="returnQuantity">
                    Quantity
                </label>

                <input
                    type="number"
                    id="returnQuantity"
                    name="quantity"
                    min="0.001"
                    step="0.001"
                    placeholder="0.000"
                    inputmode="decimal"
                    required
                >

                <small
                    class="form-help"
                    id="returnQuantityHelp"
                >
                    Enter the quantity to return.
                </small>

            </div>


            <div class="form-group full-width">

                <label for="returnReason">
                    Reason
                </label>

                <input
                    type="text"
                    id="returnReason"
                    name="reason"
                    maxlength="255"
                    placeholder="Reason for return"
                    autocomplete="off"
                >

                <small class="form-help">
                    Add any additional information about this return.
                </small>

            </div>

        </div>


        <button
            type="submit"
            class="primary-btn"
        >
            <i class="fa-solid fa-rotate-left"></i>
            Process Return
        </button>

    </form>

</section>

    </main>

</div>


