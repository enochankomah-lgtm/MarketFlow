                </div>

                <div>

                    <span>Product</span>

                    <strong id="transferQuantityProductName">
                        —
                    </strong>

                </div>

            </div>


            <!-- PRODUCT CODE -->

            <div class="quantity-available-info">

                <span>
                    Product Code
                </span>

                <strong id="transferQuantityProductCode">
