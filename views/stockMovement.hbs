                    </strong>
                </div>

                <div class="summary-item">
                    <span>Total Units</span>

                    <strong id="transferSummaryQuantity">
                        0
                    </strong>
                </div>

                <div class="summary-item">
                    <span>Source Branch</span>

                    <strong id="transferSummarySource">
                        —
                    </strong>
                </div>

                <div class="summary-item">
                    <span>Destination Branch</span>

                    <strong id="transferSummaryDestination">
                        —
                    </strong>
                </div>

