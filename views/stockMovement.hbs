<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Stock Movements - MarketFlow</title>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <!-- Stock Movement Styles -->
    <link rel="stylesheet" href="/stockMovement.css">

</head>

<body>

<div class="stock-movement-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->
    <header class="page-header">

        <div class="page-heading">

            <div class="page-heading-icon">
                <i class="fa-solid fa-arrows-rotate"></i>
            </div>

            <div>
                <span class="page-eyebrow">
                    INVENTORY MANAGEMENT
                </span>

                <h1>
                    Stock Movements
                </h1>

                <p>
                    Move, adjust and manage inventory across your business.
                </p>
            </div>

        </div>

        <a href="/dashboard" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Dashboard</span>
        </a>

    </header>


    <main class="movement-container">


        <!-- =========================================================
             LOAD VEHICLE
             ========================================================= -->
        <section
            class="movement-card load-vehicle-card"
            id="loadVehicleSection"
        >

            <!-- Section Header -->
            <div class="movement-card-header">

                <div class="movement-card-title">

                    <div class="movement-icon load-icon">
                        <i class="fa-solid fa-truck-ramp-box"></i>
                    </div>

                    <div>

                        <span class="section-eyebrow">
                            INVENTORY TRANSFER
                        </span>

                        <h2>
                            Load Vehicle
                        </h2>

                        <p>
                            Move stock from a branch into a vehicle or mobile
                            selling location.
                        </p>

                    </div>

                </div>


                <div class="movement-header-actions">

                    <button
                        type="button"
                        class="secondary-action-btn"
                        id="viewVehicleStockBtn"
                    >
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Vehicle Stock</span>
                    </button>


                    <button
                        type="button"
                        class="secondary-action-btn"
                        id="viewLoadHistoryBtn"
                    >
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Load History</span>
                    </button>

                </div>

            </div>


            <!-- =====================================================
                 LOAD VEHICLE BODY
                 ===================================================== -->
            <div class="load-vehicle-body">


                <!-- =================================================
                     SOURCE BRANCH
                     ================================================= -->
                <div class="form-group">

                    <label for="loadSourceBranch">

                        <span>
                            <i class="fa-solid fa-code-branch"></i>
                            Source Branch
                        </span>

                        <span class="required">*</span>

                    </label>


                    <div class="input-action-wrapper">

                        <select
                            id="loadSourceBranch"
                            name="source_branch_id"
                            class="form-control"
                            required
                        >

                            <option value="">
                                Select source branch
                            </option>

                            {{#each branches}}

                                <option value="{{this.branch_id}}">
                                    {{this.branch_name}}
                                </option>

                            {{/each}}

                        </select>


                        <span
                            class="field-status-icon"
                            id="sourceBranchStatus"
                        >
                            <i class="fa-solid fa-code-branch"></i>
                        </span>

                    </div>


                    <small class="form-help">
                        Select the branch where the stock will be taken from.
                    </small>

                </div>


                <!-- =================================================
                     VEHICLE
                     ================================================= -->
                <div class="form-group">

                    <div class="form-label-row">

                        <label for="loadVehicle">

                            <span>
                                <i class="fa-solid fa-truck"></i>
                                Vehicle
                            </span>

                            <span class="required">*</span>

                        </label>


                        <button
                            type="button"
                            class="inline-add-btn"
                            id="registerVehicleBtn"
                        >
                            <i class="fa-solid fa-plus"></i>
                            Register Vehicle
                        </button>

                    </div>


                    <div class="select-action-group">

                        <select
                            id="loadVehicle"
                            name="vehicle_location_id"
                            class="form-control"
                            required
                        >

                            <option value="">
                                Select vehicle
                            </option>

                            {{#each vehicles}}

                                <option
                                    value="{{this.location_id}}"
                                    data-vehicle-name="{{this.location_name}}"
                                    data-status="{{this.is_active}}"
                                >
                                    {{this.location_name}}
                                </option>

                            {{/each}}

                        </select>


                        <button
                            type="button"
                            class="select-management-btn"
                            id="manageVehiclesBtn"
                            title="Manage Vehicles"
                            aria-label="Manage Vehicles"
                        >
                            <i class="fa-solid fa-gear"></i>
                        </button>

                    </div>


                    <small class="form-help">
                        Select the vehicle that will receive the stock.
                    </small>

                </div>


                <!-- =================================================
                     PRODUCT SELECTION
                     ================================================= -->
                <div class="form-group product-selection-group">

                    <div class="form-label-row">

                        <label>

                            <span>
                                <i class="fa-solid fa-boxes-stacked"></i>
                                Products
                            </span>

                            <span class="required">*</span>

                        </label>


                        <span
                            class="selected-count-badge"
                            id="selectedProductCount"
                        >
                            0 products
                        </span>

                    </div>


                    <div class="product-selector-box">

                        <button
                            type="button"
                            class="product-picker-btn"
                            id="openProductPickerBtn"
                        >

                            <span class="product-picker-left">

                                <span class="product-picker-icon">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </span>

                                <span>

                                    <strong>
                                        Select Products
                                    </strong>

                                    <small>
                                        Search and add products to this
                                        vehicle load
                                    </small>

                                </span>

                            </span>


                            <i class="fa-solid fa-chevron-right"></i>

                        </button>

                    </div>

                </div>


                <!-- =================================================
                     SELECTED PRODUCTS SUMMARY
                     ================================================= -->
                <div
                    class="selected-products-panel"
                    id="selectedProductsPanel"
                    style="display:none;"
                >

                    <div class="selected-products-header">

                        <div>

                            <h3>
                                <i class="fa-solid fa-clipboard-list"></i>
                                Products to Load
                            </h3>

                            <span id="selectedProductsSubtext">
                                Review the products before loading.
                            </span>

                        </div>


                        <button
                            type="button"
                            class="edit-products-btn"
                            id="editSelectedProductsBtn"
                        >
                            <i class="fa-solid fa-pen-to-square"></i>
                            Edit Products
                        </button>

                    </div>


                    <div class="selected-products-table-wrapper">

                        <table class="selected-products-table">

                            <thead>

                                <tr>
                                    <th>Product</th>
                                    <th>Batch</th>
                                    <th>Available</th>
                                    <th>Load Qty</th>
                                    <th>Cost Value</th>
                                    <th>Potential Sales</th>
                                    <th></th>
                                </tr>

                            </thead>


                            <tbody id="selectedProductsTableBody">
                                <!-- Products inserted by JavaScript -->
                            </tbody>

                        </table>

                    </div>


                    <!-- Load Totals -->
                    <div class="load-totals">

                        <div class="load-total-item">

                            <span>
                                <i class="fa-solid fa-box"></i>
                                Total Products
                            </span>

                            <strong id="totalProductsValue">
                                0
                            </strong>

                        </div>


                        <div class="load-total-item">

                            <span>
                                <i class="fa-solid fa-cubes"></i>
                                Total Quantity
                            </span>

                            <strong id="totalLoadQuantity">
                                0.000
                            </strong>

                        </div>


                        <div class="load-total-item">

                            <span>
                                <i class="fa-solid fa-coins"></i>
                                Total Cost Value
                            </span>

                            <strong id="totalLoadCost">
                                0.00
                            </strong>

                        </div>


                        <div class="load-total-item">

                            <span>
                                <i class="fa-solid fa-chart-line"></i>
                                Potential Sales Value
                            </span>

                            <strong id="totalPotentialSales">
                                0.00
                            </strong>

                        </div>


                        <div class="load-total-item profit-preview">

                            <span>
                                <i class="fa-solid fa-money-bill-trend-up"></i>
                                Potential Gross Profit
                            </span>

                            <strong id="totalPotentialProfit">
                                0.00
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     LOAD NOTES
                     ================================================= -->
                <div class="form-group">

                    <label for="loadVehicleNotes">

                        <span>
                            <i class="fa-regular fa-note-sticky"></i>
                            Loading Notes
                        </span>

                        <span class="optional-label">
                            Optional
                        </span>

                    </label>


                    <textarea
                        id="loadVehicleNotes"
                        name="notes"
                        class="form-control"
                        rows="3"
                        maxlength="500"
                        placeholder="Add notes about this vehicle loading..."
                    ></textarea>


                    <div class="character-counter">
                        <span id="loadNotesCounter">0</span>/500
                    </div>

                </div>


                <!-- =================================================
                     LOAD ACTION BAR
                     ================================================= -->
                <div class="load-action-bar">

                    <div class="load-action-information">

                        <div class="load-action-icon">
                            <i class="fa-solid fa-truck-ramp-box"></i>
                        </div>


                        <div>

                            <strong id="loadActionVehicle">
                                No vehicle selected
                            </strong>

                            <span id="loadActionSummary">
                                Add products to begin loading.
                            </span>

                        </div>

                    </div>


                    <div class="load-action-buttons">

                        <button
                            type="button"
                            class="secondary-action-btn"
                            id="clearVehicleLoadBtn"
                        >
                            <i class="fa-solid fa-eraser"></i>
                            Clear
                        </button>


                        <button
                            type="button"
                            class="summary-action-btn"
                            id="viewLoadSummaryBtn"
                        >
                            <i class="fa-solid fa-chart-pie"></i>
                            Load Summary
                        </button>


                        <button
                            type="button"
                            class="primary-action-btn"
                            id="loadVehicleBtn"
                        >
                            <i class="fa-solid fa-truck-ramp-box"></i>
                            Load Vehicle
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             REGISTER VEHICLE MODAL
             ========================================================= -->
        <div
            class="movement-modal"
            id="registerVehicleModal"
            aria-hidden="true"
        >

            <div class="movement-modal-overlay"></div>


            <div class="movement-modal-container">

                <div class="movement-modal-header">

                    <div class="modal-heading">

                        <span class="modal-icon">
                            <i class="fa-solid fa-truck"></i>
                        </span>

                        <div>

                            <h3>
                                Register Vehicle
                            </h3>

                            <p>
                                Add a vehicle or mobile selling location.
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="modal-close-btn"
                        data-close-modal="registerVehicleModal"
                        aria-label="Close"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>


                <form id="registerVehicleForm">

                    <div class="movement-modal-body">

                        <div class="form-group">

                            <label for="vehicleName">

                                <span>
                                    Vehicle Name
                                </span>

                                <span class="required">*</span>

                            </label>


                            <input
                                type="text"
                                id="vehicleName"
                                name="location_name"
                                class="form-control"
                                maxlength="150"
                                placeholder="e.g. MF Delivery Van 01"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="vehicleDescription">

                                <span>
                                    Description
                                </span>

                                <span class="optional-label">
                                    Optional
                                </span>

                            </label>


                            <textarea
                                id="vehicleDescription"
                                name="description"
                                class="form-control"
                                rows="3"
                                maxlength="255"
                                placeholder="Vehicle description..."
                            ></textarea>

                        </div>


                        <div class="vehicle-registration-info">

                            <i class="fa-solid fa-circle-info"></i>

                            <div>

                                <strong>
                                    Vehicle inventory
                                </strong>

                                <p>
                                    Stock loaded into this vehicle will be
                                    tracked separately from the source branch.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="movement-modal-footer">

                        <button
                            type="button"
                            class="secondary-action-btn"
                            data-close-modal="registerVehicleModal"
                        >
                            Cancel
                        </button>


                        <button
                            type="submit"
                            class="primary-action-btn"
                        >
                            <i class="fa-solid fa-plus"></i>
                            Register Vehicle
                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- =========================================================
             MANAGE VEHICLES MODAL
             ========================================================= -->
        <div
            class="movement-modal"
            id="manageVehiclesModal"
            aria-hidden="true"
        >

            <div class="movement-modal-overlay"></div>


            <div class="movement-modal-container large-modal">

                <div class="movement-modal-header">

                    <div class="modal-heading">

                        <span class="modal-icon">
                            <i class="fa-solid fa-truck"></i>
                        </span>

                        <div>

                            <h3>
                                Manage Vehicles
                            </h3>

                            <p>
                                View and manage vehicles belonging to your
                                business.
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="modal-close-btn"
                        data-close-modal="manageVehiclesModal"
                        aria-label="Close"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>


                <div class="movement-modal-body">

                    <div class="modal-toolbar">

                        <div class="modal-search-box">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input
                                type="search"
                                id="vehicleSearchInput"
                                placeholder="Search vehicles..."
                            >

                        </div>


                        <button
                            type="button"
                            class="primary-action-btn"
                            id="modalRegisterVehicleBtn"
                        >
                            <i class="fa-solid fa-plus"></i>
                            Register Vehicle
                        </button>

                    </div>


                    <div class="vehicle-list-wrapper">

                        <table class="management-table">

                            <thead>

                                <tr>
                                    <th>Vehicle</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Current Stock</th>
                                    <th>Actions</th>
                                </tr>

                            </thead>


                            <tbody id="vehicleManagementTableBody">
                                <!-- Vehicles populated by JavaScript -->
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             PRODUCT PICKER MODAL
             ========================================================= -->
        <div
            class="movement-modal"
            id="productPickerModal"
            aria-hidden="true"
        >

            <div class="movement-modal-overlay"></div>


            <div class="movement-modal-container extra-large-modal">

                <div class="movement-modal-header">

                    <div class="modal-heading">

                        <span class="modal-icon">
                            <i class="fa-solid fa-box-open"></i>
                        </span>

                        <div>

                            <h3>
                                Select Products
                            </h3>

                            <p>
                                Search available stock and add products to this
                                vehicle load.
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="modal-close-btn"
                        data-close-modal="productPickerModal"
                        aria-label="Close"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>


                <div class="movement-modal-body">

                    <div class="product-search-toolbar">

                        <div class="large-search-box">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input
                                type="search"
                                id="productSearchInput"
                                autocomplete="off"
                                placeholder="Search product by name, code, category or brand..."
                            >


                            <button
                                type="button"
                                id="clearProductSearchBtn"
                                class="search-clear-btn"
                                style="display:none;"
                                aria-label="Clear search"
                            >
                                <i class="fa-solid fa-xmark"></i>
                            </button>

                        </div>


                        <div class="product-filter">

                            <select
                                id="productCategoryFilter"
                                class="form-control"
                            >
                                <option value="">
                                    All Categories
                                </option>
                            </select>

                        </div>

                    </div>


                    <div class="product-results-info">

                        <span>
                            <strong id="availableProductCount">
                                0
                            </strong>
                            products available
                        </span>


                        <span>
                            Source:
                            <strong id="selectedSourceBranchName">
                                No branch selected
                            </strong>
                        </span>

                    </div>


                    <div class="product-picker-table-wrapper">

                        <table class="product-picker-table">

                            <thead>

                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Batch</th>
                                    <th>Expiry</th>
                                    <th>Available</th>
                                    <th>Cost</th>
                                    <th>Selling Price</th>
                                    <th>Action</th>
                                </tr>

                            </thead>


                            <tbody id="productPickerTableBody">
                                <!-- Products populated by JavaScript -->
                            </tbody>

                        </table>

                    </div>

                </div>


                <div class="movement-modal-footer">

                    <div class="modal-footer-summary">

                        <strong id="pickerSelectedCount">
                            0 selected
                        </strong>

                        <span id="pickerSelectedQuantity">
                            0.000 quantity
                        </span>

                    </div>


                    <button
                        type="button"
                        class="secondary-action-btn"
                        data-close-modal="productPickerModal"
                    >
                        Done
                    </button>

                </div>

            </div>

        </div>


        <!-- =========================================================
             EDIT PRODUCT QUANTITY MODAL
             ========================================================= -->
        <div
            class="movement-modal"
            id="editLoadProductModal"
            aria-hidden="true"
        >

            <div class="movement-modal-overlay"></div>


            <div class="movement-modal-container">

                <div class="movement-modal-header">

                    <div class="modal-heading">

                        <span class="modal-icon">
                            <i class="fa-solid fa-box"></i>
                        </span>

                        <div>

                            <h3>
                                Edit Product Quantity
                            </h3>

                            <p>
                                Set the quantity that should be loaded.
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="modal-close-btn"
                        data-close-modal="editLoadProductModal"
                        aria-label="Close"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>


                <div class="movement-modal-body">

                    <div class="selected-product-preview">

                        <div class="selected-product-image">
                            <i class="fa-solid fa-box"></i>
                        </div>


                        <div>

                            <strong id="editProductName">
                                Product
                            </strong>

                            <span id="editProductBatch">
                                Batch: —
                            </span>

                            <span id="editProductAvailable">
                                Available: 0.000
                            </span>

                        </div>

                    </div>


                    <div class="quantity-edit-grid">

                        <div class="form-group">

                            <label for="editLoadQuantity">

                                <span>
                                    Quantity to Load
                                </span>

                                <span class="required">*</span>

                            </label>


                            <div class="quantity-input-wrapper">

                                <button
                                    type="button"
                                    class="quantity-step-btn"
                                    id="decreaseLoadQuantity"
                                    aria-label="Decrease quantity"
                                >
                                    <i class="fa-solid fa-minus"></i>
                                </button>


                                <input
                                    type="number"
                                    id="editLoadQuantity"
                                    min="0.001"
                                    step="0.001"
                                    class="form-control quantity-input"
                                >


                                <button
                                    type="button"
                                    class="quantity-step-btn"
                                    id="increaseLoadQuantity"
                                    aria-label="Increase quantity"
                                >
                                    <i class="fa-solid fa-plus"></i>
                                </button>

                            </div>

                        </div>


                        <div class="quantity-value-preview">

                            <span>
                                Cost Value
                            </span>

                            <strong id="editProductCostValue">
                                0.00
                            </strong>


                            <span>
                                Potential Sales
                            </span>

                            <strong id="editProductSalesValue">
                                0.00
                            </strong>


                            <span>
                                Potential Profit
                            </span>

                            <strong id="editProductProfitValue">
                                0.00
                            </strong>

                        </div>

                    </div>


                    <div
                        class="quantity-warning"
                        id="quantityWarning"
                        style="display:none;"
                    >

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <span>
                            The requested quantity cannot exceed available
                            stock.
                        </span>

                    </div>

                </div>


                <div class="movement-modal-footer">

                    <button
                        type="button"
                        class="secondary-action-btn"
                        data-close-modal="editLoadProductModal"
                    >
                        Cancel
                    </button>


                    <button
                        type="button"
                        class="primary-action-btn"
                        id="saveLoadProductQuantityBtn"
                    >
                        <i class="fa-solid fa-check"></i>
                        Save Quantity
                    </button>

                </div>

            </div>

        </div>


        <!-- =========================================================
             EXECUTIVE LOAD SUMMARY MODAL
             ========================================================= -->
        <div
            class="movement-modal executive-modal"
            id="loadSummaryModal"
            aria-hidden="true"
        >

            <div class="movement-modal-overlay"></div>


            <div class="movement-modal-container large-modal">

                <div class="movement-modal-header executive-header">

                    <div class="modal-heading">

                        <span class="modal-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>

                        <div>

                            <h3>
                                Vehicle Load Summary
                            </h3>

                            <p>
                                Financial and inventory overview of this
                                loading operation.
                            </p>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="modal-close-btn"
                        data-close-modal="loadSummaryModal"
                        aria-label="Close"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>


                <div class="movement-modal-body">

                    <div class="executive-summary-heading">

                        <div>

                            <span>
                                Source Branch
                            </span>

                            <strong id="summarySourceBranch">
                                —
                            </strong>

                        </div>


                        <div class="summary-arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </div>


                        <div>

                            <span>
                                Vehicle
                            </span>

                            <strong id="summaryVehicle">
                                —
                            </strong>

                        </div>

                    </div>


                    <div class="executive-kpi-grid">

                        <div class="executive-kpi">

                            <span class="kpi-icon">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </span>

                            <div>

                                <span>
                                    Total Products
                                </span>

                                <strong id="summaryTotalProducts">
                                    0
                                </strong>

                            </div>

                        </div>


                        <div class="executive-kpi">

                            <span class="kpi-icon">
                                <i class="fa-solid fa-cubes"></i>
                            </span>

                            <div>

                                <span>
                                    Total Quantity
                                </span>

