
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="theme-color" content="#166534">

    <title>Forgot Password - MarketFlow</title>

    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/login.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >
</head>

<body>

<div class="login-wrapper">

    <!-- =========================================================
         LEFT PANEL
    ========================================================== -->

    <section class="left-panel">

        <div class="brand">

            <div class="logo-box">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>

            <div>
                <h2>MarketFlow</h2>
                <span>Market Management System</span>
            </div>

        </div>


        <div class="welcome-section">

            <span class="eyebrow">
                ACCOUNT RECOVERY
            </span>

            <h1>
                Let's get you back to business.
            </h1>

            <p>
                Forgot your password? No worries.
                We'll help you regain access to your
                MarketFlow account securely.
            </p>

        </div>


        <div class="dashboard-card">

            <img
                src="https://images.pexels.com/photos/18471529/pexels-photo-18471529.jpeg"
                alt="MarketFlow business management"
            >

        </div>


        <div class="feature-list">

            <div class="feature-item">

                <i class="fa-solid fa-shield-halved"></i>

                <div>
                    <h4>Secure Recovery</h4>
                    <p>Your account remains protected.</p>
                </div>

            </div>


            <div class="feature-item">

                <i class="fa-solid fa-envelope-circle-check"></i>

                <div>
                    <h4>Email Verification</h4>
                    <p>Receive a secure password reset link.</p>
                </div>

            </div>


            <div class="feature-item">

                <i class="fa-solid fa-clock"></i>

                <div>
                    <h4>Quick Process</h4>
                    <p>Get back to managing your business.</p>
                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         RIGHT PANEL
    ========================================================== -->

    <section class="right-panel">

        <div class="login-card">

            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="form-header">

                <div class="header-top">

                    <div>

                        <span class="form-eyebrow">
                            MARKETFLOW ACCOUNT
                        </span>

                        <h2>Forgot Password?</h2>

                    </div>


                    <button
                        type="button"
                        class="home-btn"
                        onclick="window.location.href='/login'"
                    >

                        <i class="fa-solid fa-arrow-left"></i>

                        Sign In

                    </button>

                </div>


                <p>
                    Enter your registered email address and
                    we'll send you instructions to reset your password.
                </p>

            </div>



            <!-- =================================================
                 SERVER SUCCESS MESSAGE
            ================================================== -->

            {{#if message}}

                <div
                    class="message"
                    role="status"
                    aria-live="polite"
                >

                    <i class="fa-solid fa-circle-check"></i>

                    <span>
                        {{message}}
                    </span>

                </div>

            {{/if}}



            <!-- =================================================
                 SERVER ERROR MESSAGE
            ================================================== -->

            {{#if error}}

                <div
                    class="message"
                    role="alert"
                    aria-live="assertive"
                >

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <span>
                        {{error}}
                    </span>

                </div>

            {{/if}}



            <!-- =================================================
                 FORGOT PASSWORD FORM
            ================================================== -->

            <form
                id="forgotPasswordForm"
                method="POST"
                action="/auth/forgot-password"
            >

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="input-icon">

                        <i class="fa-solid fa-envelope"></i>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            autocomplete="email"
                            maxlength="100"
                            required
                            autofocus
                        >

                    </div>

                </div>



                <!-- =================================================
                     SUBMIT
                ================================================== -->

                <button
                    type="submit"
                    class="login-btn"
                    id="resetButton"
                >

                    <i class="fa-solid fa-paper-plane"></i>

                    <span>Send Reset Link</span>

                </button>



                <!-- =================================================
                     BACK TO LOGIN
                ================================================== -->

                <div class="create-account">

                    <span>
                        Remember your password?
                    </span>

                    <a href="/login">
                        Sign In Instead
                    </a>

                </div>

            </form>


        </div>

    </section>

</div>



<!-- =========================================================
     FORM INTERACTIONS
========================================================== -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const forgotPasswordForm =
        document.getElementById("forgotPasswordForm");

    const resetButton =
        document.getElementById("resetButton");


    if (forgotPasswordForm) {

        forgotPasswordForm.addEventListener(
            "submit",
            function (event) {

                if (!forgotPasswordForm.checkValidity()) {

                    event.preventDefault();

                    forgotPasswordForm.reportValidity();

                    return;
                }


                if (resetButton) {

                    resetButton.disabled = true;

                    resetButton.classList.add("loading");

                    resetButton.innerHTML = `
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Sending Reset Link...</span>
                    `;

                }

            }
        );

    }

});

</script>

</body>
</html>
