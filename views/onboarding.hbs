<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Register Your Business | MarketFlow</title>
        <link rel="stylesheet" href="/onboarding.css">
    </head>
<body>

  <div class="onboarding-page">

<div class="brand-background">
    <img src="https://i.ibb.co/mWPNw8y/marketflow-logo-png.png" alt="MarketFlow Logo" >
</div>

<main class="onboarding-card">   
    <div class="progress-area">
        <div class="progress-info">
            <span id="stepLabel">Welcome</span>
            <span id="stepNumber">1 / 7</span>
        </div>

        <div class="progress-bar">
            <div id="progressFill"></div>
        </div>
    </div>

    <section class="step active" data-step="1">
        <div class="step-icon"> <i>MF</i> </div>

        <h1>Welcome to MarketFlow</h1>

        <p>
            Let's get your business ready to use MarketFlow.
            We'll guide you through the setup one step at a time.
        </p>

        <button type="button" class="primary-btn next-btn">Let's Get Started</button>
        <button type="button" onclick="window.location.href='/'" class="success-btn next-btn">Home</button>
    </section>

    <section class="step" data-step="2">
        <div class="step-icon">
            <i>01</i>
        </div>
        <h1>Who are you?</h1>
        <p>
            Tell us how you are using MarketFlow.
        </p>

        <div class="choice-container">

            <button
                type="button"
                class="choice-card selected-choice"
                data-owner-choice="owner"
            >
                <strong>I'm the Business Owner</strong>
                <span>
                    I want to register and manage my business.
                </span>
            </button>

        </div>

        <div class="step-actions">
            <button type="button" class="secondary-btn back-btn">
                Back
            </button>

            <button type="button" class="primary-btn next-btn">
                Continue
            </button>
        </div>

    </section>


    <!-- ========================= -->
    <!-- STEP 3 -->
    <!-- ========================= -->

    <section class="step" data-step="3">

        <div class="step-icon">
            <i>02</i>
        </div>

        <h1>Register your business?</h1>

        <p>
            Would you like to register your business with
            MarketFlow and start using the system?
        </p>

        <div class="choice-container">

            <button
                type="button"
                class="choice-card registration-choice selected-choice"
                data-register="yes"
            >
                <strong>Yes, let's get started</strong>
                <span>
                    Register my business and set up my account.
                </span>
            </button>

        </div>

        <div class="step-actions">

            <button type="button" class="secondary-btn back-btn">
                Back
            </button>

            <button type="button" class="primary-btn next-btn">
                Continue
            </button>

        </div>

    </section>


    <!-- ========================= -->
    <!-- STEP 4 BUSINESS -->
    <!-- ========================= -->

    <section class="step" data-step="4">

        <div class="step-icon">
            <i>03</i>
        </div>

        <h1>Tell us about your business</h1>

        <p>
            Enter the basic information about your business.
        </p>

        <div class="form-grid">

            <div class="form-group full-width">
                <label for="business_name">
                    Business Name *
                </label>

                <input
                    type="text"
                    id="business_name"
                    name="business_name"
                    placeholder="Enter your business name"
                    required
                >
            </div>


            <div class="form-group">
                <label for="business_phone">
                    Business Phone
                </label>

                <input
                    type="tel"
                    id="business_phone"
                    name="business_phone"
                    placeholder="Business phone number"
                >
            </div>


            <div class="form-group">
                <label for="business_email">
                    Business Email
                </label>

                <input
                    type="email"
                    id="business_email"
                    name="business_email"
                    placeholder="Business email"
                >
            </div>


            <div class="form-group full-width">
                <label for="business_address">
                    Business Address
                </label>

                <input
                    type="text"
                    id="business_address"
                    name="business_address"
                    placeholder="Business address"
                >
            </div>


            <div class="form-group full-width">
                <label for="business_city">
                    City
                </label>

                <input
                    type="text"
                    id="business_city"
                    name="business_city"
                    placeholder="City"
                >
            </div>

        </div>


        <div class="step-actions">

            <button type="button" class="secondary-btn back-btn">
                Back
            </button>

            <button type="button" class="primary-btn next-btn">
                Continue
            </button>

        </div>

    </section>


    <!-- ========================= -->
    <!-- STEP 5 BRANCH -->
    <!-- ========================= -->

    <section class="step" data-step="5">

        <div class="step-icon">
            <i>04</i>
        </div>

        <h1>Set up your first branch</h1>

        <p>
            Every business starts with at least one location.
            You can add more branches later.
        </p>

        <div class="form-grid">

            <div class="form-group full-width">
                <label for="branch_name">
                    Branch Name *
                </label>

                <input
                    type="text"
                    id="branch_name"
                    name="branch_name"
                    placeholder="e.g. Main Branch"
                    required
                >
            </div>


            <div class="form-group full-width">
                <label for="branch_location">
                    Branch Location
                </label>

                <input
                    type="text"
                    id="branch_location"
                    name="branch_location"
                    placeholder="Branch location"
                >
            </div>


            <div class="form-group full-width">
                <label for="branch_phone">
                    Branch Phone
                </label>

                <input
                    type="tel"
                    id="branch_phone"
                    name="branch_phone"
                    placeholder="Branch phone number"
                >
            </div>

        </div>


        <div class="step-actions">

            <button type="button" class="secondary-btn back-btn">
                Back
            </button>

            <button type="button" class="primary-btn next-btn">
                Continue
            </button>

        </div>

    </section>


    <!-- ========================= -->
    <!-- STEP 6 OWNER -->
    <!-- ========================= -->

    <section class="step" data-step="6">

        <div class="step-icon">
            <i>05</i>
        </div>

        <h1>Create your owner account</h1>

        <p>
            You are registering this business, so MarketFlow
            will create you as the business owner.
        </p>

        <div class="form-grid">

            <div class="form-group">
                <label for="first_name">
                    First Name *
                </label>

                <input
                    type="text"
                    id="first_name"
                    name="first_name"
                    placeholder="First name"
                    required
                >
            </div>


            <div class="form-group">
                <label for="last_name">
                    Last Name *
                </label>

                <input
                    type="text"
                    id="last_name"
                    name="last_name"
                    placeholder="Last name"
                    required
                >
            </div>


            <div class="form-group full-width">
                <label for="owner_email">
                    Email *
                </label>

                <input
                    type="email"
                    id="owner_email"
                    name="owner_email"
                    placeholder="Your email address"
                    required
                >
            </div>


            <div class="form-group">
                <label for="owner_phone">
                    Phone
                </label>

                <input
                    type="tel"
                    id="owner_phone"
                    name="owner_phone"
                    placeholder="Phone number"
                >
            </div>


            <div class="form-group">
                <label for="password">
                    Password *
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Minimum 8 characters"
                    required
                >
            </div>


            <div class="form-group full-width">
                <label for="confirm_password">
                    Confirm Password *
                </label>

                <input
                    type="password"
                    id="confirm_password"
                    name="confirm_password"
                    placeholder="Confirm your password"
                    required
                >
            </div>

        </div>


        <div class="step-actions">

            <button type="button" class="secondary-btn back-btn">
                Back
            </button>

            <button type="button" class="primary-btn next-btn">
                Review
            </button>

        </div>

    </section>


    <!-- ========================= -->
    <!-- STEP 7 REVIEW -->
    <!-- ========================= -->

    <section class="step" data-step="7">

        <div class="step-icon success-icon">
            <i>✓</i>
        </div>

        <h1>Review your information</h1>

        <p>
            Please check your information before creating
            your MarketFlow business.
        </p>


        <div class="review-container">

            <div class="review-section">
                <h3>Business</h3>

                <div class="review-row">
                    <span>Name</span>
                    <strong id="reviewBusinessName">—</strong>
                </div>

                <div class="review-row">
                    <span>Phone</span>
                    <strong id="reviewBusinessPhone">—</strong>
                </div>

                <div class="review-row">
                    <span>Email</span>
                    <strong id="reviewBusinessEmail">—</strong>
                </div>

                <div class="review-row">
                    <span>Address</span>
                    <strong id="reviewBusinessAddress">—</strong>
                </div>

                <div class="review-row">
                    <span>City</span>
                    <strong id="reviewBusinessCity">—</strong>
                </div>
            </div>


            <div class="review-section">
                <h3>First Branch</h3>

                <div class="review-row">
                    <span>Branch</span>
                    <strong id="reviewBranchName">—</strong>
                </div>

                <div class="review-row">
                    <span>Location</span>
                    <strong id="reviewBranchLocation">—</strong>
                </div>

                <div class="review-row">
                    <span>Phone</span>
                    <strong id="reviewBranchPhone">—</strong>
                </div>
            </div>


            <div class="review-section">
                <h3>Owner</h3>

                <div class="review-row">
                    <span>Name</span>
                    <strong id="reviewOwnerName">—</strong>
                </div>

                <div class="review-row">
                    <span>Email</span>
                    <strong id="reviewOwnerEmail">—</strong>
                </div>

                <div class="review-row">
                    <span>Role</span>
                    <strong>Business Owner</strong>
                </div>
            </div>

        </div>


        <div id="formMessage" class="form-message"></div>


        <div class="step-actions">

            <button type="button" class="secondary-btn back-btn">
                Back
            </button>

            <button
                type="button"
                class="primary-btn"
                id="createBusinessBtn"
            >
                Create My Business
            </button>

        </div>

    </section>


</main>

</div>

<script src="/js/onboarding.js"></script>

</body>
</html>
