<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">

    <!-- Products CSS -->
    <link rel="stylesheet" href="/products.css">

    <title>Products | MarketFlow</title>
</head>

<body>

    <!-- =====================================================
         TOP NAVIGATION
    ====================================================== -->
    <header class="top-navbar">

        <div class="logo">
            <img src="https://i.ibb.co/mWPNw8y/marketflow-logo-png.png"
                 alt="MarketFlow Logo">

            <h1>
                Market<span>Flow</span>
            </h1>
        </div>

        <div class="top-actions">

            <a href="/" class="top-link">
                <i class="fas fa-house"></i>
                Home
            </a>

            <a href="/main" class="top-link">
                <i class="fas fa-chart-line"></i>
                Main
            </a>

            <a
                href="/productpages/inventory"
                class="add-product-btn"
            >
                <i class="fas fa-plus"></i>
                Add Product
            </a>

        </div>

    </header>


    <!-- =====================================================
         PAGE LAYOUT
    ====================================================== -->
    <div class="page-layout">


        <!-- =================================================
             SIDEBAR
        ================================================== -->
        <aside class="sidebar">

            <div class="sidebar-title">
                <span>MAIN MENU</span>
            </div>


            <a href="/productpages/main" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-cash-register"></i>
                </div>
                <span>Point Of Sales</span>
            </a>


            <a href="/productpages/inventory" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-boxes-stacked"></i>
                </div>
                <span>Inventory</span>
            </a>


            <a href="/products" class="sidebar-link active">
                <div class="sidebar-icon">
                    <i class="fas fa-box"></i>
                </div>
                <span>Products</span>
            </a>


            <a href="/customer-overview" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-users"></i>
                </div>
                <span>Customers</span>
            </a>


            <a href="/stockanalysis/inventoryanalyst" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-boxes-stacked"></i>
                </div>
                <span>Inventory Analytics</span>
            </a>

            <a href="/profitabledashboard" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-chart-pie"></i>
                </div>
                <span>Profit & Revenue</span>
            </a>

            <a href="/product-performance" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <span>Product Performance</span>
            </a>

            <a href="/settings" class="sidebar-link">
                <div class="sidebar-icon">
                    <i class="fas fa-cog"></i>
                </div>
                <span>Settings</span>
            </a>


            <div class="sidebar-bottom">

                <div class="system-status">
                    <span class="status-dot"></span>
                    <span>System Online</span>
                </div>

                <small>MarketFlow Management</small>

            </div>

        </aside>


        <!-- =================================================
             MAIN CONTENT
        ================================================== -->
        <main class="main-content">


            <!-- PAGE HEADER -->
            <section class="page-header">

                <div class="header-text">

                    <div class="breadcrumb">
                        <i class="fas fa-house"></i>
                        <span>/</span>
                        <span>Products</span>
                    </div>

                    <div class="title-row">

                        <div>
                            <h2>Product Management</h2>

                            <p>
                                Manage your products, pricing, stock information
                                and supplier details from one place.
                            </p>
                        </div>

                        <div class="product-count">
                            <i class="fas fa-boxes-stacked"></i>
                            <div>
                                <strong>{{products.length}}</strong>
                                <span>Products</span>
                            </div>
                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 STATISTICS
            ================================================== -->
            <section class="stats-grid">


                <div class="stat-card">

                    <div class="stat-icon sales-icon">
                        <i class="fas fa-money-bill-trend-up"></i>
                    </div>

                    <div class="stat-info">
                        <span>Total Expected Sales Value</span>
                        <h3>GH₵ {{totalsales}}</h3>
                        <small>
                            <i class="fas fa-chart-line"></i>
                            Expected revenue
                        </small>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon cost-icon">
                        <i class="fas fa-coins"></i>
                    </div>

                    <div class="stat-info">
                        <span>Total Cost Value</span>
                        <h3>GH₵ {{totalcost}}</h3>
                        <small>
                            <i class="fas fa-calculator"></i>
                            Inventory cost
                        </small>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon profit-icon">
                        <i class="fas fa-arrow-trend-up"></i>
                    </div>

                    <div class="stat-info">
                        <span>Net Profit</span>
                        <h3>GH₵ {{totalProfit}}</h3>
                        <small>
                            <i class="fas fa-chart-pie"></i>
                            Estimated profit
                        </small>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon products-icon">
                        <i class="fas fa-boxes-stacked"></i>
                    </div>

                    <div class="stat-info">
                        <span>Available Products</span>
                        <h3>{{products.length}}</h3>
                        <small class="warning-text">
                            <i class="fas fa-clock"></i>
                            {{expiringdate}} expiring soon
                        </small>
                    </div>

                </div>


            </section>


            <!-- =================================================
                 PRODUCTS SECTION
            ================================================== -->
            <section class="products-panel">


                <!-- PRODUCTS HEADER -->
                <div class="products-toolbar">

                    <div class="products-title">

                        <div class="section-icon">
                            <i class="fas fa-box-open"></i>
                        </div>

                        <div>
                            <span>PRODUCT CATALOG</span>
                            <h2>My Products</h2>
                        </div>

                    </div>


                    <div class="toolbar-actions">

                        <div class="search-box">

                            <i class="fas fa-magnifying-glass"></i>

                            <input
                                type="text"
                                id="productSearch"
                                placeholder="Search products..."
                                autocomplete="off">

                        </div>


                        <a href="/productpages/inventory"
                           class="new-product-btn">

                            <i class="fas fa-plus"></i>
                            New Product

                        </a>

                    </div>

                </div>


                <!-- PRODUCT GRID -->
                <div class="products-grid" id="productsGrid">


                    {{#each products}}

                    <article class="product-card">


                        <!-- PRODUCT IMAGE -->
                        <div class="product-image-container">

                            {{#if product_image}}

                                <img
                                    src="{{product_image}}"
                                    alt="{{product_name}}">

                            {{else}}

                                <div class="no-product-image">
                                    <i class="fas fa-box-open"></i>
                                    <span>No Image</span>
                                </div>

                            {{/if}}


                            <div class="stock-badge">
                                <i class="fas fa-cubes"></i>
                                {{totalavailable}} {{unit}}
                            </div>

                        </div>


                        <!-- PRODUCT CONTENT -->
                        <div class="product-content">


                            <div class="product-meta">
                                <span class="category-badge">
                                    {{category}}
                                </span>
                            </div>


                            <h3 class="product-name">
                                {{product_name}}
                            </h3>


                            <p class="product-brand">
                                <i class="fas fa-tag"></i>
                                {{brand}}
                            </p>


                            <div class="price-row">

                                <div>
                                    <span class="price-label">
                                        Selling Price
                                    </span>

                                    <strong class="product-price">
                                        GH₵ {{selling_price}}
                                    </strong>
                                </div>

                                <span class="unit-label">
                                    / {{unit}}
                                </span>

                            </div>


                            <div class="product-footer">


                                <div class="stock-info">

                                    <span>Stock Available</span>

                                    <strong>
                                        {{totalavailable}}
                                    </strong>

                                </div>


                               <a
                                    href="/productpages/products/edit/{{product_id}}"
                                    class="edit-btn"
                                >
                                    <i class="fas fa-pen-to-square"></i>
                                    Edit
                                </a>


                            </div>

                        </div>

                    </article>

                    {{/each}}


                    <!-- EMPTY STATE -->
                    <div class="empty-state" id="emptyState">

                        <div class="empty-icon">
                            <i class="fas fa-box-open"></i>
                        </div>

                        <h3>No products found</h3>

                        <p>
                            Try a different search or add a new product
                            to your catalog.
                        </p>

                        <a href="/productpages/inventory"
                           class="empty-action">

                            <i class="fas fa-plus"></i>
                            Add Product

                        </a>

                    </div>


                </div>

            </section>


            <!-- PAGE FOOTER -->
            <footer class="page-footer">

                <div>
                    <i class="fas fa-shield-halved"></i>
                    Product information is securely managed by MarketFlow.
                </div>

                <span>
                    MarketFlow Product Management
                </span>

            </footer>


        </main>

    </div>




    <!-- =====================================================
         EDIT PRODUCT MODAL
    ====================================================== -->



    <!-- Bootstrap -->
    <script src="/js/bootstrap.bundle.min.js"></script>



    <!-- =====================================================
         PRODUCT SEARCH
    ====================================================== -->
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("productSearch");

            const productCards =
                document.querySelectorAll(".product-card");

            const emptyState =
                document.getElementById("emptyState");


            searchInput.addEventListener("input", function () {

                const searchValue =
                    this.value.trim().toLowerCase();

                let visibleProducts = 0;


                productCards.forEach(card => {

                    const productName =
                        card.querySelector(".product-name")
                            .textContent
                            .toLowerCase();

                    const productCategory =
                        card.querySelector(".category-badge")
                            .textContent
                            .toLowerCase();

                    const productBrand =
                        card.querySelector(".product-brand")
                            .textContent
                            .toLowerCase();


                    const matches =
                        productName.includes(searchValue) ||
                        productCategory.includes(searchValue) ||
                        productBrand.includes(searchValue);


                    if (matches) {

                        card.style.display = "";

                        visibleProducts++;

                    } else {

                        card.style.display = "none";

                    }

                });


                if (visibleProducts === 0) {

                    emptyState.classList.add("show");

                } else {

                    emptyState.classList.remove("show");

                }

            });

        });

    </script>

</body>

</html>