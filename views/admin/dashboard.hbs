<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard - MarketFlow</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f6f8;
            color: #222;
        }

        .header {
            background: #1f2937;
            color: white;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .header a {
            color: white;
            text-decoration: none;
            margin-left: 18px;
        }

        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h2 {
            margin-bottom: 6px;
        }

        .welcome p {
            margin: 0;
            color: #666;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 24px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            margin: 0 0 10px;
            color: #555;
            font-size: 15px;
        }

        .card .number {
            font-size: 32px;
            font-weight: bold;
        }

        .actions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .action-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .action-card h3 {
            margin-top: 0;
        }

        .action-card p {
            color: #666;
            line-height: 1.5;
        }

        .button {
            display: inline-block;
            padding: 11px 18px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            margin-top: 8px;
        }

        .button:hover {
            background: #1d4ed8;
        }

        .button.secondary {
            background: #374151;
        }

        .button.secondary:hover {
            background: #1f2937;
        }

        @media (max-width: 750px) {
            .cards,
            .actions {
                grid-template-columns: 1fr;
            }

            .header {
                padding: 15px 20px;
            }

            .header a {
                margin-left: 8px;
            }
        }
    </style>
</head>

<body>

    <header class="header">
        <h1>MarketFlow Admin Portal</h1>

        <nav>
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/registrations">Registrations</a>
            <a href="/admin/employees">Employees</a>
            <a href="/auth/logout">Logout</a>
        </nav>
    </header>

    <main class="container">

        <section class="welcome">
            <h2>Administration Dashboard</h2>
            <p>
                Manage registrations, employees, and branches for your business.
            </p>
        </section>

        <section class="cards">

            <div class="card">
                <h3>Pending Registrations</h3>
                <div class="number">
                    {{pendingRegistrations}}
                </div>
            </div>

            <div class="card">
                <h3>Total Employees</h3>
                <div class="number">
                    {{totalEmployees}}
                </div>
            </div>

            <div class="card">
                <h3>Total Branches</h3>
                <div class="number">
                    {{totalBranches}}
                </div>
            </div>

        </section>

        <section class="actions">

            <div class="action-card">
                <h3>Registration Approvals</h3>

                <p>
                    Review users who registered for your business and approve
                    or reject their accounts.
                </p>

                <a href="/admin/registrations" class="button">
                    View Registrations
                </a>
            </div>

            <div class="action-card">
                <h3>Employee Management</h3>

                <p>
                    Create employees, manage their accounts, and activate or
                    deactivate existing employees.
                </p>

                <a href="/admin/employees" class="button secondary">
                    Manage Employees
                </a>
            </div>

        </section>

    </main>

</body>
</html>