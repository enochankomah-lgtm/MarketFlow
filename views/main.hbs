    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>        
        
        const AddProductPurchase = document.getElementById('productpurchasing');
        const Addquantity = document.getElementById('quantity');

        var price;

            AddProductPurchase.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget; 
                const productId = button.getAttribute('data-id');
                const productName = button.getAttribute('data-name');
                const SellingPrice = button.getAttribute('data-selling');
                price = Number(SellingPrice);
                const quantity = Number(Addquantity.value);                
                
                document.getElementById('product_id').value = productId;
                document.getElementById('product_name').value = productName;
                document.getElementById('cost_price').value = SellingPrice;
                document.getElementById('total_product').value = price * quantity;              
            });

            document.addEventListener("DOMContentLoaded", function (){
            const productquantity = document.getElementById("quantity");
            const productminus = document.getElementById("quantity-minus");
            const productplus = document.getElementById("quantity-plus");

            productplus.addEventListener("click", function() {
                var newquantity = Number(productquantity.value) + 1;
                productquantity.value = newquantity;
                document.getElementById('total_product').value = price * newquantity;
            });

            productquantity.addEventListener("keyup", function() {
                var newquantity = Number(productquantity.value);
                productquantity.value = newquantity;
                document.getElementById('total_product').value = price * newquantity;
            });

            productminus.addEventListener("click", function() {
                if (Number(productquantity.value) > 0) {
                   var newquantity = Number(productquantity.value) - 1;
                   productquantity.value = newquantity;
                   document.getElementById('total_product').value = price * newquantity;

                }

            });
          productquantity.value = '';
        });
        

    </script>

    <script>
    
      function deleteitem(sales_id){

        if(confirm('Do you want to delete this item')){
            fetch(`/productpages/sales/delete/${sales_id}`,{
                method:'DELETE'
            })
            .then(res => res.json())
            .then(data =>{
                alert(data.message);
                location.reload();
            })
            .catch(err =>{
               console.log(err)
               alert('error whiles deleting this item')
            })
        }
      }

    </script>
<script>
    const priceSearch = document.getElementById("priceSearch");

    priceSearch.addEventListener("keyup", function () {

    const value = this.value.toLowerCase();

    const rows = document.querySelectorAll("#priceTableBody tr");

    rows.forEach(row => {

        const productId = row.cells[0].textContent.toLowerCase();
        const productName = row.cells[1].textContent.toLowerCase();

        if (
            productId.includes(value) ||
            productName.includes(value)
        ) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }

    });

});
</script>

<script>
    async function recallholdsale(invoiceNumber){

    const response = await fetch(`/productpages/recall/${invoiceNumber}`,{
        method:"POST"
    });

    const data = await response.json();

    if(data.success){
        location.reload();
    }else{
        alert(data.message);
    }

}
</script>

<script>
    function ChangeAmount() {
        const amountPaying = Number(
            document.getElementById("paidAmount").value
        );

        const grandTotal = Number(
            document.getElementById("amountPayable").textContent
        );

        const changeAmount = amountPaying - grandTotal;

        document.getElementById("changeAmount").textContent =
            changeAmount.toFixed(2);

        document.getElementById("cashAmountPaid").value =  amountPaying.toFixed(2);

        document.getElementById("cashModalChange").textContent = changeAmount.toFixed(2);

    }
</script>

<script>
    function openPaymentModal(modalId) {
        document.getElementById(modalId).style.display = "flex";
    }

    function closePaymentModal(modalId) {
        document.getElementById(modalId).style.display = "none";
    }
</script>


 <script>
const productimagecard = document.querySelectorAll('.product-initial');

productimagecard.forEach(productImage => {

    const productimage = productImage.textContent.trim();

    if (productimage) {

        const firstletter = productimage
            .split(/\s+/)
            .map(word => word[0])
            .join('')
            .substring(0, 2)
            .toUpperCase();

        productImage.textContent = firstletter;

    }

});
</script>

