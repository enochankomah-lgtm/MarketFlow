<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b6517">
    <title>MarketFlow - Point of Sales</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/main.css">
</head>

<body>
    <!-- MAIN NAVIGATION -->
    <nav class="main-navbar" aria-label="Main navigation">
        <div class="logo">
            <i class="fas fa-store" aria-hidden="true">▣</i>
            <div class="logo-text">
                <h2>MarketFlow</h2>
            </div>
        </div>

        <div class="search-container">
            <input
                class="searchitem"
                id="searchcategory"
                type="search"
                placeholder="Search products..."
                aria-label="Search products">

            <div class="dropdown">
                <button
                    class="btn category-btn dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                    All Product Pages
                </button>

                <ul class="dropdown-menu">               
                    <li><a class="dropdown-item" href="/productpages/products">□ Products</a></li>                    
                </ul>
            </div>

            <button type="button" class="search-btn" aria-label="Search">
                <i class="fas fa-search" aria-hidden="true">⌕</i>
            </button>
        </div>

        <div class="right-menu">
            <div class="dropdown mobile-nav-menu">
                <button
                    type="button"
                    class="mobile-nav-btn dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Open navigation">
                    <i class="fa-solid fa-bars" aria-hidden="true">☰</i>
                    <span>Menu</span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/productpages/main">▣ Point of Sales</a></li>
                    <li><a class="dropdown-item" href="/productpages/products">□ Products</a></li>
                    <li><a class="dropdown-item" href="/customers">♙ Customer Trends</a></li>
                    <li>
                        <button
                            class="dropdown-item"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#Inventorysystem">
                            ▤ Inventory Records
                        </button>
                    </li>
                    <li><a class="dropdown-item" href="/performance">◈ Business Performance</a></li>
                    <li><a class="dropdown-item" href="/insights">✦ Generate Insights</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/cashier-dashboard">▣ Statistics</a></li>
                </ul>
            </div>

            <div class="dropdown">
                <button
                    type="button"
                    class="logout-btn dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                    <i class="fa-solid fa-circle-user" aria-hidden="true">●</i>
                    User Profile
                </button>

                <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                    <li class="dropdown-header">
                        <i class="fa-solid fa-circle-user" aria-hidden="true">●</i>
                        <div>
                            <strong>{{name}}</strong>
                            <small>{{RoleName}}</small>
                        </div>
                    </li>

                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#" id="myProfileBtn">♙ My Profile</a></li>
                    <li><a class="dropdown-item" href="#">⚙ Settings</a></li>
                    <li><a class="dropdown-item" href="#" id="openChangePasswordModal">⚿ Change Password</a></li>

                    <li><hr class="dropdown-divider"></li>

                    <li>
                        <a
                            class="dropdown-item logout-item"
                            href="/auth/logout"
                            onclick="return confirm('Are you sure you want to sign out?')">
                            ⇥ Sign Out
                        </a>
                    </li>
                </ul>
            </div>

            <div class="menu-item">
                <i class="fas fa-user-circle" aria-hidden="true">●</i>
                <div>
                    <small>User On duty</small>
                    <span>Welcome, {{name}}</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- CATEGORY PANEL -->
    <aside class="category-card" aria-label="Product categories">
        <div class="category-header">
            <i class="fa-solid fa-border-all" aria-hidden="true">▦</i>
            <span>CATEGORIES</span>
        </div>

        <div class="category-item">
            <div class="category-row" onclick="filterCategory('All')">
                <span aria-hidden="true">▦</span>
                <span>All</span>
            </div>

            {{#each categories}}
                <div class="category-row" onclick="filterCategory('{{category}}')">
                    <span aria-hidden="true">□</span>
                    <span>{{category}}</span>
                </div>
            {{/each}}
        </div>

        <div class="category-footer">
            <div class="category-actions">
                <button
                    type="button"
                    class="category-action customer-action"
                    id="customersBtn"
                    data-bs-toggle="modal"
                    data-bs-target="#customerModal"
                    data-bs-backdrop="false">
                    <span class="category-action-icon" aria-hidden="true">♙</span>
                    <span>Customers</span>
                </button>

                <a
                    href="/cashier-dashboard"
                    class="category-action statistics-action"
                    id="cashierDashboardBtn">
                    <span class="category-action-icon" aria-hidden="true">◈</span>
                    <span>Statistics</span>
                </a>
            </div>
        </div>
    </aside>

    <!-- CASHIER SHORTCUTS -->
    <div class="shortcut-toolbar" aria-label="Cashier shortcuts">
        <button
            type="button"
            class="shortcut-btn"
            data-bs-target="#newSaleBtn"
            data-bs-toggle="modal">
            <div class="shortcut-icon green">
                <i class="fa-solid fa-cart-plus" aria-hidden="true">+</i>
            </div>
            <div class="shortcut-text">
                <span class="shortcut-key">F1</span>
                <span class="shortcut-title">New Sale</span>
            </div>
        </button>

        <button
            type="button"
            class="shortcut-btn"
            data-bs-target="#holdSaleBtn"
            data-bs-toggle="modal">
            <div class="shortcut-icon orange">
                <i class="fa-solid fa-box" aria-hidden="true">□</i>
            </div>
            <div class="shortcut-text">
                <span class="shortcut-key">F3</span>
                <span class="shortcut-title">Hold Sale</span>
            </div>
        </button>

        <button
            type="button"
            class="shortcut-btn"
            id="RecallSale"
            data-bs-target="#RecallSaleModal"
            data-bs-toggle="modal">
            <div class="shortcut-icon blue">
                <i class="fa-solid fa-folder-open" aria-hidden="true">▣</i>
            </div>
            <div class="shortcut-text">
                <span class="shortcut-key">F4</span>
                <span class="shortcut-title">Recall Sale</span>
            </div>
        </button>

        <button
            type="button"
            class="shortcut-btn"
            id="priceCheckBtn"
            data-bs-target="#pricechecking"
            data-bs-toggle="modal">
            <div class="shortcut-icon purple">
                <i class="fa-solid fa-barcode" aria-hidden="true">▥</i>
            </div>
            <div class="shortcut-text">
                <span class="shortcut-key">F5</span>
                <span class="shortcut-title">Price Check</span>
            </div>
        </button>
    </div>

    <!-- PRODUCTS -->
    <main class="products-container" aria-label="Products">
        <section class="products">
            {{#each products}}
                <article class="product-card" data-category="{{category}}">
                    <div class="product-image-container">
                        {{#if product_image}}
                            <img
                                src="{{product_image}}"
                                alt="{{product_name}}"
                                class="product-image"
                                loading="lazy"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        {{/if}}

                        <div
                            class="product-initial"
                            {{#if product_image}}style="display:none;"{{/if}}>
                            {{product_name}}
                        </div>
                    </div>

                    <div class="content">
                        <h5 class="product-name">{{product_name}}</h5>
                        <span class="price">GH₵ {{selling_price}} / {{unit}}</span>

                        <div class="stock-btn">
                            <small>Stock: {{totalavailable}}</small>

                            <button
                                type="button"
                                class="add-btn edit-btn {{#if (lt totalavailable 6)}}danger{{/if}}"
                                {{#if (numberequal totalavailable 0)}}disabled{{/if}}
                                data-bs-toggle="modal"
                                data-bs-target="#productpurchasing"
                                data-id="{{product_id}}"
                                data-name="{{product_name}}"
                                data-category="{{category}}"
                                data-brand="{{brand}}"
                                data-unit="{{unit}}"
                                data-cost="{{cost_price}}"
                                data-selling="{{selling_price}}"
                                data-msrp="{{msrp}}"
                                data-description="{{description}}"
                                data-image="{{product_image}}"
                                data-supplier="{{supplier_name}}"
                                data-expiry="{{expiry_date}}">
                                <i class="fa-solid fa-bag-shopping" aria-hidden="true">▣</i>
                                Sell
                            </button>
                        </div>
                    </div>
                </article>
            {{else}}
                <div class="empty-products">
                    <h3>No products available</h3>
                    <p>Add products to begin selling.</p>
                </div>
            {{/each}}
        </section>
    </main>

    <!-- CART / PAYMENT PANEL -->
    <aside class="purchasepoint" aria-label="Current sale">
        <section class="salesreview">
            <div class="cartstyle">
                <div>
                    <span class="section-kicker">CURRENT SALE</span>
                    <h5>Cart</h5>
                </div>

                <form
                    action="/productpages/clearCart"
                    method="POST"
                    id="clearCartForm">
                    <button type="submit" class="delete-btn">
                        Clear Cart
                        <i class="fa-solid fa-trash" aria-hidden="true">×</i>
                    </button>
                </form>
            </div>

            <div class="table-scroll">
                <table class="purchase_ite">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Total</th>
                            <th><span class="visually-hidden">Remove</span></th>
                        </tr>
                    </thead>

                    <tbody class="salesbody">
                        {{#each initialsales}}
                            <tr>
                                <td>{{@index}}</td>

                                <td class="product-info">
                                    <div class="product-name">{{product_name}}</div>
                                    <small>GH₵ {{Selling_price}}</small>
                                </td>

                                <td>
                                    <div class="qty-boxx">
                                        <button
                                            type="button"
                                            class="minus"
                                            aria-label="Decrease quantity">
                                            −
                                        </button>

                                        <span>{{quantity}}</span>

                                        <button
                                            type="button"
                                            class="plus"
                                            aria-label="Increase quantity">
                                            +
                                        </button>
                                    </div>
                                </td>

                                <td>GH₵ {{Selling_price}}</td>
                                <td>GH₵ {{total_price}}</td>

                                <td>
                                    <button
                                        type="button"
                                        class="delete-btn"
                                        onclick="deleteitem('{{sales_id}}')"
                                        aria-label="Remove {{product_name}}">
                                        <i class="fa-solid fa-trash" aria-hidden="true">×</i>
                                    </button>
                                </td>
                            </tr>
                        {{else}}
                            <tr class="empty-cart-row">
                                <td colspan="6">
                                    <div class="empty-cart">
                                        <strong>Your cart is empty</strong>
                                        <span>Select a product to add it to the sale.</span>
                                    </div>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="subtotalinfo">
            <div class="cart-summary">
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span class="amount">GH₵ {{subtotal}}</span>
                </div>

                <div class="summary-row">
                    <div class="discount-label">
                        <span>Discount</span>
                        <button
                            type="button"
                            class="discount-btn"
                            aria-label="Discount">
                            <i class="fa-solid fa-percent" aria-hidden="true">%</i>
                        </button>
                    </div>

                    <span class="amount">GH₵ {{discount}}</span>
                </div>

                <div class="summary-row">
                    <span>Tax</span>
                    <span class="amount">GH₵ {{tax}}</span>
                </div>

                <hr>

                <div class="summary-row grand-total">
                    <span>Grand Total</span>
                    <span>GH₵ {{grandTotal}}</span>
                </div>
            </div>
        </section>

        <section class="payment-section">
            <div class="payment-top">
                <div class="amount-section">
                    <p>Amount Payable</p>
                    <h2>GH₵ <span id="amountPayable">{{grandTotal}}</span></h2>
                </div>

                <div class="payment-inputs">
                    <div class="payment-row">
                        <label for="paidAmount">Paid</label>
                        <input
                            type="number"
                            id="paidAmount"
                            placeholder="0.00"
                            step="0.01"
                            min="0"
                            inputmode="decimal"
                            oninput="ChangeAmount()">
                    </div>

                    <div class="payment-row">
                        <label for="changeAmount">Change</label>
                        <h3>GH₵ <span id="changeAmount">0.00</span></h3>
                    </div>
                </div>
            </div>
        </section>

        <section class="payment-methods" aria-label="Payment methods">
            <button
                type="button"
                class="payment-btn cash"
                onclick="openPaymentModal('cashPaymentModal')">
                <i class="fa-solid fa-money-bill-wave" aria-hidden="true">₵</i>
                <span>Cash</span>
            </button>

            <button
                type="button"
                class="payment-btn momo"
                onclick="openMomoPaymentModal()">
                <i class="fa-solid fa-mobile-screen-button" aria-hidden="true">☎</i>
                <span>Mobile Money</span>
            </button>

            <button
                type="button"
                class="payment-btn cardmethod"
                onclick="openPaymentModal('cardPaymentModal')">
                <i class="fa-regular fa-credit-card" aria-hidden="true">▭</i>
                <span>Card</span>
            </button>

            <button
                type="button"
                class="payment-btn split"
                onclick="openPaymentModal('splitPaymentModal')">
                <i class="fa-solid fa-code-branch" aria-hidden="true">÷</i>
                <span>Split Payment</span>
            </button>
        </section>
    </aside>


    <!-- PRICE CHECK MODAL -->
    <div class="modal fade" id="pricechecking" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modalprice modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">▥ Product Price Check</h5>
                    <button
                        type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <input
                            type="search"
                            id="priceSearch"
                            class="form-control"
                            placeholder="Search Product Name or Product ID..."
                            autocomplete="off">
                    </div>

                    <div class="table-scroll">
                        <table class="purchase_item">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Brand</th>
                                    <th>Unit</th>
                                    <th>Price</th>
                                </tr>
                            </thead>

                            <tbody id="priceTableBody">
                                {{#each products}}
                                    <tr>
                                        <td class="product-info">
                                            <div class="product-name">{{product_name}}</div>
                                        </td>
                                        <td>{{category}}</td>
                                        <td>{{brand}}</td>
                                        <td>{{unit}}</td>
                                        <td class="fw-bold text-success">
                                            GH₵ {{selling_price}}
                                        </td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PRODUCT SALE MODAL -->
    <div class="modal fade" id="productpurchasing" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">□ Add Product to Sale</h5>
                    <button
                        type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    </button>
                </div>

                <div class="modal-body p-4">
                    <div class="entirecontainer">
                        <form
                            action="/productpages/sales/add"
                            method="POST"
                            id="productSaleForm">

                            <div class="top-section">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="icon">□</div>
                                        <div>
                                            <p>PURCHASING INFORMATION</p>
                                            <h2>ITEM / QUANTITY</h2>
                                        </div>
                                    </div>

                                    <div class="inputs">
                                        <div class="inputs1">
                                            <label for="product_name">Product Name</label>

                                            <input
                                                class="productname"
                                                type="text"
                                                id="product_name"
                                                name="product_name"
                                                placeholder="Product Name"
                                                autocomplete="off"
                                                required>

                                            <input
                                                type="hidden"
                                                id="product_id"
                                                name="ProductId">

                                            <div class="searchbox" id="itembox"></div>

                                            <label for="quantity">Quantity</label>

                                            <div class="setquantity">
                                                <button
                                                    type="button"
                                                    class="minus"
                                                    id="quantity-minus"
                                                    aria-label="Decrease quantity">
                                                    −
                                                </button>

                                                <input
                                                    class="Quantityinput"
                                                    type="number"
                                                    id="quantity"
                                                    name="quantity"
                                                    placeholder="Quantity"
                                                    min="1"
                                                    step="1"
                                                    inputmode="numeric"
                                                    required>

                                                <button
                                                    type="button"
                                                    class="plus"
                                                    id="quantity-plus"
                                                    aria-label="Increase quantity">
                                                    +
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="card-header">
                                        <div class="icon">₵</div>
                                        <div>
                                            <p>PRICE DETAILS</p>
                                            <h2>PRODUCT PRICING</h2>
                                        </div>
                                    </div>

                                    <div class="inputs">
                                        <label for="selling_price">Price Each</label>

                                        <input
                                            class="priceEach"
                                            type="number"
                                            step="0.01"
                                            min="0"
                                            id="selling_price"
                                            name="PriceEach"
                                            placeholder="Price Each"
                                            required>

                                        <input
                                            type="hidden"
                                            id="cost_price"
                                            name="Costprice">

                                        <label for="total_product">Total Price</label>

                                        <input
                                            class="totalprice"
                                            type="number"
                                            step="0.01"
                                            min="0"
                                            id="total_product"
                                            name="TotalPrice"
                                            placeholder="Total Price"
                                            readonly>
                                    </div>
                                </div>

                                <button type="submit" class="Addpurchase">
                                    Add to Cart
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RECALL HELD SALES -->
    <div class="modal fade" id="RecallSaleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog recallsales modal-xl modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header recall-header">
                    <h3 class="modal-title text-white fw-bold">Held Sales</h3>
                    <button
                        type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    </button>
                </div>

                <div class="modal-body p-4">
                    <div class="held-table">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Invoice No.</th>
                                    <th>Cashier</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Date Held</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                {{#each temporalsales}}
                                    <tr>
                                        <td class="fw-bold">{{invoice_number}}</td>
                                        <td>{{cashier_id}}</td>
                                        <td>{{customer_id}}</td>
                                        <td>
                                            <span class="badge-held">{{hold_status}}</span>
                                        </td>
                                        <td>{{created_at}}</td>
                                        <td>
                                            <button
                                                type="button"
                                                class="btn recall-btn"
                                                onclick="recallholdsale('{{invoice_number}}')">
                                                ↶ Recall
                                            </button>
                                        </td>
                                    </tr>
                                {{else}}
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            No held sales available.
                                        </td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HOLD CURRENT SALE -->
    <div class="modal fade" id="holdSaleBtn" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered holdsale-dialog">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header holdsale-header">
                    <h4 class="modal-title">▣ Hold Current Sale</h4>
                    <button
                        type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="holdsale-wrapper">
                        <div class="holdsale-card">
                            <div class="holdsale-card-header">
                                <div>
                                    <h5>Current Cart</h5>
                                    <p>Save this sale and continue serving another customer.</p>
                                </div>

                                <div class="holdsale-badge">
                                    {{initialsales.length}} Items
                                </div>
                            </div>

                            <div class="holdsale-table">
                                <table class="purchase_ite">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Item</th>
                                            <th>Quantity</th>
                                            <th>Price</th>
                                            <th>Total</th>
                                            <th></th>
                                        </tr>
                                    </thead>

                                    <tbody class="salesbody">
                                        {{#each initialsales}}
                                            <tr>
                                                <td>{{@index}}</td>

                                                <td class="product-info">
                                                    <div class="product-name">{{product_name}}</div>
                                                    <small>GH₵ {{Selling_price}}</small>
                                                </td>

                                                <td>
                                                    <div class="qty-boxx">
                                                        <button
                                                            type="button"
                                                            class="minus"
                                                            aria-label="Decrease quantity">
                                                            −
                                                        </button>

                                                        <span>{{quantity}}</span>

                                                        <button
                                                            type="button"
                                                            class="plus"
                                                            aria-label="Increase quantity">
                                                            +
                                                        </button>
                                                    </div>
                                                </td>

                                                <td>GH₵ {{Selling_price}}</td>
                                                <td>GH₵ {{total_price}}</td>

                                                <td>
                                                    <button
                                                        type="button"
                                                        class="delete-btn"
                                                        onclick="deleteitem('{{sales_id}}')"
                                                        aria-label="Remove item">
                                                        ×
                                                    </button>
                                                </td>
                                            </tr>
                                        {{else}}
                                            <tr>
                                                <td colspan="6" class="text-center py-4">
                                                    Cart is empty.
                                                </td>
                                            </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>

                            <div class="holdsale-footer">
                                <div>
                                    <h6>Total Cart Items</h6>
                                    <span>{{initialsales.length}}</span>
                                </div>

                                <form
