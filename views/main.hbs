    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const holdForm = document.getElementById("holdSaleForm");
            const holdMessage = document.getElementById("holdSaleMessage");

            if (holdForm) {
                holdForm.addEventListener("submit", async (event) => {
                    event.preventDefault();

                    const button = holdForm.querySelector("button[type='submit']");

                    if (button) {
                        button.disabled = true;
                    }

                    try {
                        const response = await fetch(holdForm.action, {
                            method: "POST",
                            headers: {
                                "Accept": "application/json"
                            }
                        });

                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            throw new Error(data.message || "Unable to hold sale.");
                        }

                        if (holdMessage) {
                            holdMessage.className = "alert alert-success mt-3 mb-0";
                            holdMessage.textContent =
                                data.message || "Sale held successfully.";
                        }

                        setTimeout(() => {
                            window.location.href = "/productpages/main";
                        }, 700);
                    } catch (error) {
                        if (holdMessage) {
                            holdMessage.className = "alert alert-danger mt-3 mb-0";
                            holdMessage.textContent =
                                error.message || "Unable to hold sale.";
                        }

                        if (button) {
                            button.disabled = false;
                        }
                    }
                });
            }

            const clearCartForm = document.getElementById("clearCartForm");

            if (clearCartForm) {
                clearCartForm.addEventListener("submit", (event) => {
                    if (!confirm("Clear all items from the current cart?")) {
                        event.preventDefault();
                    }
                });
            }

            const newSaleForm = document.getElementById("newSaleForm");

            if (newSaleForm) {
                newSaleForm.addEventListener("submit", (event) => {
                    if (!confirm("Start a new sale and clear the current cart?")) {
                        event.preventDefault();
                    }
                });
            }
        });
    </script>
    <script>

</script>
