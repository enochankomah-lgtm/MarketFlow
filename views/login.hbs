<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login - MarketFlow</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/login.css">
    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>
        <div class="register-wrapper">
        <!-- LEFT SIDE -->

        <section class="left-panel">
            <div class="brand">
                <div class="logo-box"><i class="fa-solid fa-cart-shopping"></i> </div>
                <div>
                <h2>MarketFlow</h2>
                <span>Market Management System</span>
                </div>
            </div>

            <div class="welcome-section">
                <h1> Sign in to </h1>
                <h3> Grow your business smarter</h3>
                <p>Manage products, sales, inventory and your team from one powerful platform.</p>
            </div>

            <div class="dashboard-card">
            <img src="https://images.pexels.com/photos/18471529/pexels-photo-18471529.jpeg">
            </div>

            <div class="feature-list">
                <div class="feature-item">
                <i class="fa-solid fa-shield-halved"></i>
                <div>
            <h4>Secure System</h4>
            <p> Your business data is protected. </p>

            </div>

            </div>

            <div class="feature-item">
                <i class="fa-solid fa-chart-line"></i>
                <div>
                <h4> Business Analytics</h4>
                <p> Track your performance easily. </p>
                </div>
            </div>
            <div class="feature-item"> <i class="fa-solid fa-users"></i> <div>
                <h4> Staff Management </h4>
                <p>Control users and permissions.</p>
                </div>
            </div>
            </div>
        </section>

        <!-- RIGHT SIDE -->


        <section class="right-panel">
            <div class="register-card">
                <div class="form-header">
                    <div class="header-top">
                    <h2>Sign in</h2>

                    <button onclick="window.location.href='/'"> Home </button>
                    </div>
                    <p>
                    Fill up information to join MarketFlow
                    </p>
                </div>

                <form method="post" action="/auth/login">

                    <div class="form-group">

                        <label>
                        Email Address
                        </label>

                        <input type="email" name="email" value="">

                    </div>

                    <div class="form-group">

                        <label>
                        Password
                        </label>

                        <input type="password" name="password" value="">

                    </div>

                    <button class="register-btn">
                    login
                    </button>


                    {{#if message}}

                    <div class="message">

                    {{message}}

                    </div>

                    {{/if}}
                    
                </form>
            </div>
        </section>
        </div>
</body>
</html>